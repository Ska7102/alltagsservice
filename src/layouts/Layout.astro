<!-- ==========================================
     Google Analytics 4 – nur nach Einwilligung
========================================== -->

<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){window.dataLayer.push(arguments);}

  // Standard: keine Analyse ohne ausdrückliche Einwilligung.
  gtag('consent', 'default', {
    analytics_storage: 'denied',
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    wait_for_update: 500
  });

  const GA_MEASUREMENT_ID = 'G-EBB7L4C9KJ';
  const CONSENT_KEY = 'alltagsservice_cookie_consent';

  function loadGoogleAnalytics() {
    if (document.querySelector('script[data-alltagsservice-ga]')) return;

    gtag('consent', 'update', {
      analytics_storage: 'granted',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied'
    });

    const script = document.createElement('script');
    script.async = true;
    script.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
    script.setAttribute('data-alltagsservice-ga', 'true');
    document.head.appendChild(script);

    gtag('js', new Date());
    gtag('config', GA_MEASUREMENT_ID);
  }

  function setConsent(value) {
    localStorage.setItem(CONSENT_KEY, value);

    if (value === 'accepted') {
      loadGoogleAnalytics();
    } else {
      gtag('consent', 'update', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied'
      });
    }

    const banner = document.getElementById('cookie-banner');
    const settings = document.getElementById('cookie-settings');
    if (banner) banner.hidden = true;
    if (settings) settings.hidden = false;
  }

  function showCookieBanner() {
    const banner = document.getElementById('cookie-banner');
    const settings = document.getElementById('cookie-settings');
    if (banner) banner.hidden = false;
    if (settings) settings.hidden = true;
  }

  document.addEventListener('DOMContentLoaded', function () {
    const savedConsent = localStorage.getItem(CONSENT_KEY);
    const banner = document.getElementById('cookie-banner');
    const settings = document.getElementById('cookie-settings');
    const accept = document.getElementById('cookie-accept');
    const reject = document.getElementById('cookie-reject');
    const manage = document.getElementById('cookie-manage');

    if (savedConsent === 'accepted') {
      if (banner) banner.hidden = true;
      if (settings) settings.hidden = false;
      loadGoogleAnalytics();
    } else if (savedConsent === 'rejected') {
      if (banner) banner.hidden = true;
      if (settings) settings.hidden = false;
    } else {
      if (banner) banner.hidden = false;
      if (settings) settings.hidden = true;
    }

    if (accept) accept.addEventListener('click', function () {
      setConsent('accepted');
    });

    if (reject) reject.addEventListener('click', function () {
      setConsent('rejected');
    });

    if (manage) manage.addEventListener('click', function () {
      showCookieBanner();
    });
  });
</script>

