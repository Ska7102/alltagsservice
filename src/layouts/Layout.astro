---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
}

const {
  title = "Alltagsservice Wien | Alltagshilfe & persönliche Unterstützung"
} = Astro.props;
---

<!DOCTYPE html>

<html lang="de">

<head>

<meta charset="UTF-8" />

<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0" />

<title>{title}</title>

<!-- ==========================================
     Basis SEO
========================================== -->

<meta
  name="description"
  content="Alltagsservice Wien: persönliche und zuverlässige Alltagshilfe in 1220 Donaustadt und 1210 Floridsdorf. Gartenarbeit, Möbelmontage, Renovierungen, Haushalt und Technik – persönlich und direkt vor Ort."
/>

<meta
  name="keywords"
  content="Alltagsservice Wien, Alltagshilfe Wien, Unterstützung im Alltag Wien, Alltagsservice 1220, Alltagshilfe Donaustadt, Alltagsservice 1210, Alltagshilfe Floridsdorf, Gartenhilfe Wien, Gartenarbeit Wien, Haushaltshilfe Wien, Besorgungen Wien, Möbelmontage Wien, Kleinreparaturen Wien, Renovierungen Wien, Renovierungsarbeiten Wien, Renovierungen 1220, Renovierungen 1210, Technikhilfe Wien, Computerhilfe Wien, Smart Home Einrichtung Wien, Smart Home Konfiguration Wien, Smart TV Einrichtung Wien, Kontowiederherstellung Wien, Hilfe bei Kontowiederherstellung, Urlaubsvertretung Pflanzen Wien, Pflanzen gießen Urlaub Wien, Tierbetreuung Urlaub Wien"
/>

<meta
  name="author"
  content="Sascha Kattenberg" />

<meta
  name="robots"
  content="index, follow" />

<meta
  name="theme-color"
  content="#2F6D73" />

<meta
  name="format-detection"
  content="telephone=yes" />

<link
  rel="canonical"
  href="https://alltagsservices.netlify.app/" />

<!-- ==========================================
     Open Graph
========================================== -->

<meta
  property="og:type"
  content="website" />

<meta
  property="og:locale"
  content="de_AT" />

<meta
  property="og:site_name"
  content="Alltagsservice Wien" />

<meta
  property="og:title"
  content="Alltagsservice Wien | Alltagshilfe & persönliche Unterstützung" />

<meta
  property="og:description"
  content="Alltagsservice Wien: persönliche und zuverlässige Alltagshilfe in 1220 Donaustadt und 1210 Floridsdorf. Hilfe bei Gartenarbeit, Haushalt, Besorgungen, Kleinreparaturen, Technik und Begleitungen." />

<meta
  property="og:url"
  content="https://alltagsservices.netlify.app/" />

<meta
  property="og:image"
  content="https://alltagsservices.netlify.app/images/logo.png" />

<meta
  property="og:image:alt"
  content="Logo Alltagsservice Wien" />

<!-- ==========================================
     Twitter / X
========================================== -->

<meta
  name="twitter:card"
  content="summary_large_image" />

<meta
  name="twitter:title"
  content="Alltagsservice Wien | Alltagshilfe & persönliche Unterstützung" />

<meta
  name="twitter:description"
  content="Persönliche und zuverlässige Alltagshilfe in 1220 Donaustadt und 1210 Floridsdorf – bei Gartenarbeit, Haushalt, Besorgungen, Kleinreparaturen, Technik und Begleitungen." />

<meta
  name="twitter:image"
  content="https://alltagsservices.netlify.app/images/logo.png" />

<!-- ==========================================
     Strukturierte Unternehmensdaten
========================================== -->

