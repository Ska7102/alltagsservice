---
interface Props {
  title?: string;
}

const { title = "Alltagsservice" } = Astro.props;
---

<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Poppins:wght@500;600;700&display=swap"
    rel="stylesheet"
  />
</head>

<body>

<header>
  <div class="container">

    <div class="logo">
      Alltagsservice
    </div>

    <nav>
      <a href="/">Home</a>
      <a href="#">Leistungen</a>
      <a href="#about">Über mich</a>
      <a href="#kontakt">Kontakt</a>
    </nav>

  </div>
</header>

<slot />

<footer>

  <div class="container footer">

    © 2026 Alltagsservice

    <div>
      Impressum |
      Datenschutz
    </div>

  </div>

</footer>

</body>

</html>

<style>

:root{

--background:#FAF9F6;
--green:#7A9E7E;
--petrol:#2F6F73;
--orange:#C96A4A;
--text:#333;

}

*{
box-sizing:border-box;
}

body{background:
linear-gradient(
180deg,
#FAF9F6 0%,
#F7F5F0 45%,
#FFFFFF 100%
);

margin:0;

font-family:Inter,sans-serif;

background:var(--background);

color:var(--text);

}

.container{

max-width:1100px;

margin:auto;

padding:20px;

}

header{

background:white;

box-shadow:0 2px 10px rgba(0,0,0,.05);

position:sticky;

top:0;

}

header .container{

display:flex;

justify-content:space-between;

align-items:center;

}

.logo{

font-family:Poppins,sans-serif;

font-size:1.5rem;

font-weight:700;

color:var(--petrol);

}

nav{

display:flex;

gap:25px;

}

nav a{

text-decoration:none;

color:#444;

font-weight:500;

}

nav a:hover{

color:var(--green);

}

footer{

margin-top:80px;

background:#eee;

padding:25px 0;

}

.footer{

display:flex;

justify-content:space-between;

align-items:center;

font-size:.9rem;

}

</style>