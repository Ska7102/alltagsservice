---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
}

const {
  title = "Alltagsservice Wien | Haushalt, Einkauf & Alltagshilfe in Wien"
} = Astro.props;
---

<!DOCTYPE html>

<html lang="de">

<head>

<meta charset="UTF-8" />

<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0" />

<title>{title}</title>

<meta
  name="description"
  content="Alltagsservice Wien – Persönliche Hilfe im Haushalt, Einkauf, Garten, Begleitung und Alltagshilfe in Wien und Umgebung. Zuverlässig, freundlich und flexibel." />

<meta
  name="keywords"
  content="Alltagsservice Wien, Alltagshilfe Wien, Haushaltshilfe Wien, Einkaufsservice Wien, Begleitservice Wien, Gartenhilfe Wien, Hilfe im Alltag Wien" />

<meta
  name="author"
  content="Sascha Kattenberg" />

<meta
  name="robots"
  content="index, follow" />

<meta
  name="theme-color"
  content="#2F6D73" />

<meta
  name="format-detection"
  content="telephone=yes" />

<link
  rel="canonical"
  href="https://alltagsservices.netlify.app/" />

<!-- Open Graph -->

<meta
  property="og:type"
  content="website" />

<meta
  property="og:locale"
  content="de_AT" />

<meta
  property="og:title"
  content="Alltagsservice Wien | Haushalt, Einkauf & Alltagshilfe in Wien" />

<meta
  property="og:description"
  content="Persönliche Unterstützung im Alltag in Wien und Umgebung. Haushalt, Einkäufe, Gartenarbeiten, Begleitung und vieles mehr." />

<meta
  property="og:url"
  content="https://alltagsservices.netlify.app/" />

<meta
  property="og:site_name"
  content="Alltagsservice" />

<meta
  property="og:image"
  content="https://alltagsservices.netlify.app/images/hero.jpg" />

<!-- Twitter / X -->

<meta
  name="twitter:card"
  content="summary_large_image" />

<meta
  name="twitter:title"
  content="Alltagsservice Wien | Haushalt, Einkauf & Alltagshilfe in Wien" />

<meta
  name="twitter:description"
  content="Persönliche Hilfe im Alltag in Wien und Umgebung." />

<meta
  name="twitter:image"
  content="https://alltagsservices.netlify.app/images/hero.jpg" />

<script
  type="application/ld+json"
  is:inline>

{
  "@context":"https://schema.org",
  "@type":"LocalBusiness",
  "name":"Alltagsservice",
  "url":"https://alltagsservices.netlify.app",
  "image":"https://alltagsservices.netlify.app/images/hero.jpg",
  "telephone":"+436604623979",
  "email":"alltagsservice@chello.at",
  "address":{
    "@type":"PostalAddress",
    "streetAddress":"Rugierstraße 28/4/4",
    "postalCode":"1220",
    "addressLocality":"Wien",
    "addressCountry":"AT"
  },
  "areaServed":"Osten Wiens und Umgebung",
  "openingHours":"Mo-Su 08:00-18:00",
  "priceRange":"€",
  "description":"Persönliche Unterstützung im Alltag. Haushalt, Einkäufe, Gartenarbeiten, Begleitung und kleine Reparaturen.",
  "sameAs":[
    "https://alltagsservices.netlify.app"
  ]
}

</script>

<link
  rel="preconnect"
  href="https://fonts.googleapis.com" />

<link
  rel="preconnect"
  href="https://fonts.gstatic.com"
  crossorigin />

<link
  href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap"
  rel="stylesheet" />

<link
  rel="icon"
  type="image/svg+xml"
  href="/favicon.svg" />

<style is:global>
:root{

--petrol:#2F6D73;
--orange:#E89A3D;
--cream:#FAF8F3;
--white:#FFFFFF;
--light:#F5F7F6;

--text:#333333;
--text-light:#666666;

--radius:22px;

--shadow:
0 12px 35px rgba(0,0,0,.08);

--shadow-hover:
0 20px 50px rgba(0,0,0,.15);

--transition:.30s;

--container:1180px;

}

/* ------------------------------------------------ */
/* RESET */
/* ------------------------------------------------ */

*,
*::before,
*::after{

margin:0;
padding:0;
box-sizing:border-box;

}

html{

scroll-behavior:smooth;

}

body{

font-family:"Montserrat",sans-serif;

background:var(--cream);

color:var(--text);

line-height:1.7;

overflow-x:hidden;

}

img{

display:block;

max-width:100%;

height:auto;

}

a{

text-decoration:none;

color:inherit;

transition:var(--transition);

}

.container{

max-width:var(--container);

margin:0 auto;

padding-inline:24px;

}

main{

min-height:70vh;

}

section{

padding:110px 0;

}

/* ------------------------------------------------ */
/* TYPOGRAFIE */
/* ------------------------------------------------ */

h1{

font-size:clamp(3rem,6vw,5rem);

line-height:1.05;

font-weight:800;

letter-spacing:-1px;

margin-bottom:28px;

color:var(--petrol);

}

h2{

font-size:clamp(2.2rem,4vw,3.2rem);

font-weight:700;

margin-bottom:24px;

color:var(--petrol);

}

h3{

font-size:1.4rem;

font-weight:700;

margin-bottom:16px;

color:var(--petrol);

}

p{

font-size:1.08rem;

line-height:1.9;

color:var(--text-light);

}

strong{

color:var(--text);

}

.section-title{

text-align:center;

margin-bottom:18px;

}

.section-subtitle{

max-width:760px;

margin:0 auto 70px;

text-align:center;

font-size:1.1rem;

color:var(--text-light);

}

.section-eyebrow{

display:inline-block;

padding:10px 20px;

border-radius:999px;

background:#EAF5F3;

color:var(--petrol);

font-weight:700;

margin-bottom:22px;

}

/* ------------------------------------------------ */
/* BUTTONS */
/* ------------------------------------------------ */

.btn{

display:inline-flex;

justify-content:center;

align-items:center;

padding:16px 34px;

min-height:56px;

border:none;

border-radius:999px;

background:var(--orange);

color:white;

font-weight:700;

cursor:pointer;

box-shadow:var(--shadow);

transition:var(--transition);

}

.btn:hover{

transform:translateY(-4px);

box-shadow:var(--shadow-hover);

}

.btn-outline{

background:white;

border:2px solid var(--petrol);

color:var(--petrol);

}
/* ------------------------------------------------ */
/* CARDS */
/* ------------------------------------------------ */

.card{

background:white;

border-radius:var(--radius);

padding:38px;

box-shadow:var(--shadow);

display:flex;

flex-direction:column;

height:100%;

transition:var(--transition);

}

.card:hover{

transform:translateY(-6px);

box-shadow:var(--shadow-hover);

}

.icon{

width:72px;

height:72px;

border-radius:20px;

background:#EAF5F3;

display:flex;

justify-content:center;

align-items:center;

font-size:2rem;

margin-bottom:22px;

transition:var(--transition);

}

.card:hover .icon{

transform:scale(1.08);

}

/* ------------------------------------------------ */
/* GRID */
/* ------------------------------------------------ */

.grid{

display:grid;

gap:35px;

}

.grid-2{

grid-template-columns:repeat(2,1fr);

}

.grid-3{

grid-template-columns:repeat(3,1fr);

}

/* ------------------------------------------------ */
/* ABSTÄNDE */
/* ------------------------------------------------ */

.mt-1{margin-top:1rem;}
.mt-2{margin-top:2rem;}
.mt-3{margin-top:3rem;}
.mt-4{margin-top:4rem;}

.mb-1{margin-bottom:1rem;}
.mb-2{margin-bottom:2rem;}
.mb-3{margin-bottom:3rem;}
.mb-4{margin-bottom:4rem;}

/* ------------------------------------------------ */
/* ANIMATION */
/* ------------------------------------------------ */

.fade-up{

animation:fadeUp .8s ease forwards;

}

@keyframes fadeUp{

from{

opacity:0;

transform:translateY(30px);

}

to{

opacity:1;

transform:none;

}

}

/* ------------------------------------------------ */
/* FORMULARE */
/* ------------------------------------------------ */

input,
textarea{

width:100%;

padding:16px 18px;

font-family:inherit;

font-size:1rem;

border:1px solid #d9d9d9;

border-radius:16px;

transition:var(--transition);

background:white;

}

input:focus,
textarea:focus{

outline:none;

border-color:var(--petrol);

box-shadow:0 0 0 3px rgba(47,109,115,.15);

}

textarea{

resize:vertical;

min-height:180px;

}

/* ------------------------------------------------ */
/* RESPONSIVE */
/* ------------------------------------------------ */

@media(max-width:1024px){

.grid-3{

grid-template-columns:repeat(2,1fr);

}

}

@media(max-width:900px){

section{

padding:80px 0;

}

.container{

padding-inline:18px;

}

.grid-2,
.grid-3{

grid-template-columns:1fr;

}

.card{

padding:30px;

}

.section-subtitle{

margin-bottom:45px;

}

.btn{

width:100%;

max-width:340px;

}

}

@media(max-width:600px){

h1{

font-size:2.6rem;

}

h2{

font-size:2rem;

}

h3{

font-size:1.25rem;

}

p{

font-size:1rem;

}

section{

padding:65px 0;

}

}
</style>

</head>

<body>

<Header />

<main>

  <slot />

</main>

<Footer />

</body>

</html>
