---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
}

const {
  title = "Alltagsservice Wien 1210, 1220 & 1020 | Persönliche Unterstützung im Alltag"
} = Astro.props;
---

<!DOCTYPE html>

<html lang="de">

<head>

<meta charset="UTF-8" />

<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0" />

<title>{title}</title>

<!-- ==========================================
     Basis SEO
========================================== -->

<meta
  name="description"
  content="Persönliche Unterstützung im Alltag in Wien. Besonders in 1210 Floridsdorf, 1220 Donaustadt und 1020 Leopoldstadt. Hilfe bei Einkäufen, Begleitungen, Gartenarbeiten, Organisation im Haushalt und vielen weiteren alltäglichen Aufgaben." />

<meta
  name="keywords"
  content="Alltagsservice Wien, Alltagsservice 1210, Alltagsservice 1220, Alltagsservice 1020, Alltagshilfe Wien, Alltagshilfe Floridsdorf, Alltagshilfe Donaustadt, Alltagshilfe Leopoldstadt, Unterstützung im Alltag Wien, Einkaufsservice Wien, Begleitservice Wien, Gartenhilfe Wien, Seniorenhilfe Wien" />

<meta
  name="author"
  content="Sascha Kattenberg" />

<meta
  name="robots"
  content="index, follow" />

<meta
  name="theme-color"
  content="#2F6D73" />

<meta
  name="format-detection"
  content="telephone=yes" />

<link
  rel="canonical"
  href="https://alltagsservices.netlify.app/" />

<!-- ==========================================
     Open Graph
========================================== -->

<meta
  property="og:type"
  content="website" />

<meta
  property="og:locale"
  content="de_AT" />

<meta
  property="og:site_name"
  content="Alltagsservice Wien" />

<meta
  property="og:title"
  content="Alltagsservice Wien 1210, 1220 & 1020 | Persönliche Unterstützung im Alltag" />

<meta
  property="og:description"
  content="Persönliche Unterstützung im Alltag in Floridsdorf, Donaustadt und Leopoldstadt. Zuverlässig, freundlich und flexibel." />

<meta
  property="og:url"
  content="https://alltagsservices.netlify.app/" />

<meta
  property="og:image"
  content="https://alltagsservices.netlify.app/images/logo.png" />

<meta
  property="og:image:alt"
  content="Logo Alltagsservice Wien" />

<!-- ==========================================
     Twitter / X
========================================== -->

<meta
  name="twitter:card"
  content="summary_large_image" />

<meta
  name="twitter:title"
  content="Alltagsservice Wien 1210, 1220 & 1020" />

<meta
  name="twitter:description"
  content="Persönliche Unterstützung im Alltag in Wien. Zuverlässig, freundlich und flexibel." />

<meta
  name="twitter:image"
  content="https://alltagsservices.netlify.app/images/logo.png" />
<!-- ==========================================
     Strukturierte Unternehmensdaten
========================================== -->

<script
  type="application/ld+json"
  is:inline>

{
  "@context":"https://schema.org",

  "@type":"LocalBusiness",

  "name":"Alltagsservice Wien",

  "url":"https://alltagsservices.netlify.app",

  "logo":"https://alltagsservices.netlify.app/images/logo.png",

  "image":"https://alltagsservices.netlify.app/images/logo.png",

  "telephone":"+436604623979",

  "email":"alltagsservice@chello.at",

  "priceRange":"€",

  "description":"Persönliche Unterstützung im Alltag in Wien. Zuverlässige Hilfe bei Einkäufen, Begleitungen, Organisation im Haushalt, Gartenarbeiten und vielen weiteren alltäglichen Aufgaben.",

  "address":{

    "@type":"PostalAddress",

    "streetAddress":"Rugierstraße 28/4/4",

    "postalCode":"1220",

