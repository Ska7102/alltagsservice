---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
}

const {
  title = "Alltagsservice Wien | Persönlich & zuverlässig"
} = Astro.props;
---

<!doctype html>

<html lang="de">

<head>

<meta charset="UTF-8" />

<meta name="viewport" content="width=device-width, initial-scale=1" />

<meta
name="description"
content="Alltagsservice Wien – Hilfe im Haushalt, Garten, Einkauf, Begleitung und vieles mehr. Persönlich, zuverlässig und flexibel."
/>

<title>{title}</title>

<link rel="preconnect" href="https://fonts.googleapis.com">

<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

<style is:global>

:root{

--petrol:#2F6D73;

--orange:#E69A3B;

--cream:#FAF8F3;

--white:#ffffff;

--text:#333333;

--light:#F2F5F4;

--radius:18px;

--shadow:0 12px 35px rgba(0,0,0,.08);

--max:1180px;

}

*{

margin:0;

padding:0;

box-sizing:border-box;

}

html{

scroll-behavior:smooth;

}

body{

font-family:"Montserrat",sans-serif;

background:var(--cream);

color:var(--text);

line-height:1.7;

overflow-x:hidden;

}

img{

max-width:100%;

display:block;

}

a{

text-decoration:none;

color:inherit;

}

section{

padding:90px 20px;

}

.container{

max-width:var(--max);

margin:auto;

}

h1{

font-size:clamp(2.4rem,5vw,4.6rem);

font-weight:800;

line-height:1.1;

margin-bottom:25px;

}

h2{

font-size:clamp(2rem,4vw,3rem);

margin-bottom:25px;

color:var(--petrol);

}

h3{

font-size:1.3rem;

margin-bottom:12px;

}

p{

font-size:1.05rem;

}

.btn{

display:inline-flex;

align-items:center;

justify-content:center;

padding:16px 34px;

border-radius:999px;

background:var(--orange);

color:white;

font-weight:700;

transition:.25s;

box-shadow:var(--shadow);

}

.btn:hover{

transform:translateY(-3px);

}

.btn-outline{

background:white;

color:var(--petrol);

border:2px solid var(--petrol);

}

@media(max-width:900px){

section{

padding:70px 18px;

}

}

</style>

</head>

<body>

<Header />

<main>

<slot />

</main>

<Footer />

</body>

</html>