---

const advantages = [

{
icon:"🤝",
title:"Persönlicher Ansprechpartner",
text:"Sie sprechen immer direkt mit mir – keine Hotline, keine wechselnden Mitarbeiter, sondern persönlicher Service von Anfang an."
},

{
icon:"⭐",
title:"Zuverlässig & pünktlich",
text:"Absprachen werden eingehalten. Ich arbeite sorgfältig, pünktlich und mit großem Verantwortungsbewusstsein."
},

{
icon:"❤️",
title:"Mit Herz dabei",
text:"Freundlichkeit, Respekt und Geduld gehören für mich selbstverständlich zu jeder Unterstützung."
},

{
icon:"🕒",
title:"Flexible Unterstützung",
text:"Ob einmalige Hilfe oder regelmäßige Unterstützung – gemeinsam finden wir die passende Lösung für Ihren Alltag."
}

];

---

<section id="why">

<div class="container">

<div class="section-header">

<span class="section-eyebrow">

Warum Alltagsservice?

</span>

<h2 class="section-title">

Darauf können Sie sich
<br>

jederzeit verlassen.

</h2>

<p class="section-subtitle">

Vertrauen entsteht nicht nur durch Erfahrung,
sondern vor allem durch Zuverlässigkeit,
Respekt und den persönlichen Umgang miteinander.

</p>

</div>

<div class="why-grid">

{

advantages.map((item)=>(

<article class="why-card">

<div class="why-icon">

{item.icon}

</div>

<h3>

{item.title}

</h3>

<p>

{item.text}

</p>

</article>

))

}

</div>

<div class="why-bottom">

<div class="why-highlight">

<div class="highlight-icon">

🏡

</div>

<div>

<h3>

Persönlich. Zuverlässig. Mit Herz.

</h3>

<p>

Mein Ziel ist es,
Menschen im Alltag zuverlässig zu unterstützen
und dabei stets ein vertrauensvoller Ansprechpartner
zu sein.

</p>

</div>

</div>

</div>

</div>

</section>
<style>

#why{

background:linear-gradient(
180deg,
#F5F7F6 0%,
#FAF8F3 100%
);

overflow:hidden;

}

.section-header{

text-align:center;

margin-bottom:70px;

}

.why-grid{

display:grid;

grid-template-columns:repeat(2,1fr);

gap:32px;

margin-bottom:70px;

}

.why-card{

background:white;

padding:38px;

border-radius:28px;

box-shadow:0 12px 35px rgba(0,0,0,.06);

border:1px solid rgba(47,109,115,.06);

transition:all .35s ease;

display:flex;

flex-direction:column;

height:100%;

position:relative;

overflow:hidden;

}

.why-card::before{

content:"";

position:absolute;

left:0;

top:0;

width:100%;

height:5px;

background:linear-gradient(
90deg,
var(--petrol),
var(--orange)
);

transform:scaleX(0);

transform-origin:left;

transition:.35s;

}

.why-card:hover{

transform:translateY(-10px);

box-shadow:0 22px 45px rgba(0,0,0,.12);

}

.why-card:hover::before{

transform:scaleX(1);

}

.why-icon{

width:84px;

height:84px;

border-radius:24px;

background:#EAF5F3;

display:flex;

justify-content:center;

align-items:center;

font-size:2.4rem;

margin-bottom:26px;

transition:.35s;

}

.why-card:hover .why-icon{

background:var(--petrol);

color:white;

transform:rotate(-6deg) scale(1.08);

}

.why-card h3{

margin-bottom:18px;

font-size:1.45rem;

}

.why-card p{

line-height:1.85;

flex:1;

}

.why-bottom{

display:flex;

justify-content:center;

}

.why-highlight{

background:white;

border-radius:32px;

padding:42px;

display:flex;

align-items:center;

gap:30px;

max-width:900px;

width:100%;

box-shadow:0 15px 40px rgba(0,0,0,.08);

border-left:8px solid var(--orange);

transition:.35s;

}

.why-highlight:hover{

transform:translateY(-6px);

box-shadow:0 22px 50px rgba(0,0,0,.12);

}

.highlight-icon{

width:100px;

height:100px;

border-radius:28px;

background:var(--petrol);

display:flex;

justify-content:center;

align-items:center;

font-size:3rem;

color:white;

flex-shrink:0;

}

.why-highlight h3{

margin-bottom:14px;

font-size:1.6rem;

}

.why-highlight p{

margin:0;

line-height:1.9;

}

@media(max-width:1024px){

.why-grid{

grid-template-columns:1fr;

}

.why-highlight{

flex-direction:column;

text-align:center;

}

}

@media(max-width:768px){

#why{

padding-top:80px;

padding-bottom:80px;

}

.section-header{

margin-bottom:50px;

}

.why-grid{

gap:24px;

margin-bottom:45px;

}

.why-card{

padding:30px;

}

.why-icon{

width:70px;

height:70px;

font-size:2rem;

margin-bottom:20px;

}

.why-highlight{

padding:30px;

gap:20px;

}

.highlight-icon{

width:80px;

height:80px;

font-size:2.4rem;

}

.why-highlight h3{

font-size:1.35rem;

}

}

</style>
