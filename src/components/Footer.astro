<style>

.footer{

background:linear-gradient(
180deg,
#2F6D73 0%,
#295F64 100%
);

color:white;

padding:72px 0 26px;

}

/* =====================================
   GRID
===================================== */

.footer-grid{

display:grid;

grid-template-columns:1.7fr 1fr 1fr;

gap:72px;

align-items:start;

margin-bottom:55px;

}

/* =====================================
   LOGO
===================================== */

.footer-logo{

display:flex;

align-items:center;

gap:14px;

text-decoration:none;

margin-bottom:20px;

}

.footer-logo-image{

width:42px;

height:42px;

object-fit:contain;

transition:.30s;

}

.footer-logo:hover .footer-logo-image{

transform:rotate(-4deg) scale(1.06);

}

.footer-logo-text{

display:flex;

flex-direction:column;

}

.brand-name{

font-size:1.55rem;

font-weight:800;

line-height:1.1;

color:white;

}

.brand-tagline{

margin-top:4px;

font-size:.74rem;

text-transform:uppercase;

letter-spacing:.10em;

font-weight:700;

color:var(--orange);

}

.footer-description{

margin-top:18px;

max-width:310px;

line-height:1.9;

color:rgba(255,255,255,.82);

}

/* =====================================
   SPALTEN
===================================== */

.footer-column h4{

margin-bottom:22px;

font-size:1.12rem;

font-weight:700;

color:white;

}

.footer-column ul{

list-style:none;

padding:0;

margin:0;

display:flex;

flex-direction:column;

gap:14px;

}

.footer-column a{

color:rgba(255,255,255,.86);

text-decoration:none;

transition:.25s;

}

.footer-column a:hover{

color:white;

padding-left:5px;

}

/* =====================================
   KONTAKTLEISTE
===================================== */

.footer-contact-bar{

display:grid;

grid-template-columns:repeat(4,1fr);

gap:20px;

margin-bottom:55px;

}

.contact-card{

display:flex;

align-items:center;

gap:14px;

padding:18px 20px;

background:rgba(255,255,255,.08);

border:1px solid rgba(255,255,255,.10);

backdrop-filter:blur(8px);

border-radius:18px;

text-decoration:none;

color:white;

transition:.30s;

}

.contact-card:hover{

background:rgba(255,255,255,.14);

transform:translateY(-4px);

box-shadow:0 12px 28px rgba(0,0,0,.15);

}

.contact-icon{

width:48px;

height:48px;

border-radius:14px;

background:rgb(136, 110, 110);

display:flex;

justify-content:center;

align-items:center;

font-size:1.25rem;

color: #f5750c;
flex-shrink:0;

}

.contact-card strong{

display:block;

margin-bottom:4px;

font-size:.92rem;

font-weight:700;

color:white;

}

.contact-card span{

font-size:.93rem;

line-height:1.55;

color:rgba(255,255,255,.88);

}

/* =====================================
   FOOTER BOTTOM
===================================== */

.footer-bottom{

padding-top:26px;

border-top:1px solid rgba(255,255,255,.12);

display:flex;

justify-content:space-between;

align-items:center;

gap:30px;

flex-wrap:wrap;

}

.footer-bottom p{

margin:0;

font-size:.92rem;

color:rgba(255,255,255,.70);

}

.footer-bottom nav{

display:flex;

align-items:center;

gap:26px;

}

.footer-bottom nav a{

color:rgba(255,255,255,.88);

text-decoration:none;

font-weight:600;

transition:.25s;

}

.footer-bottom nav a:hover{

color:white;

}

.separator{

color:rgba(255,255,255,.35);

}

/* =====================================
   TABLET
===================================== */

@media(max-width:1100px){

.footer-grid{

grid-template-columns:1fr 1fr;

gap:45px;

}

.footer-contact-bar{

grid-template-columns:repeat(2,1fr);

}

}

/* =====================================
   SMARTPHONE
===================================== */

@media(max-width:768px){

.footer{

padding-top:55px;

}

.footer-grid{

grid-template-columns:1fr;

text-align:center;

gap:40px;

}

.footer-logo{

justify-content:center;

}

.footer-description{

margin:18px auto 0;

}

.footer-column ul{

align-items:center;

}

.footer-contact-bar{

grid-template-columns:1fr;

gap:16px;

}

.contact-card{

text-align:left;

}

.footer-bottom{

flex-direction:column;

text-align:center;

}

.footer-bottom nav{

justify-content:center;

}

}

/* =====================================
   KLEINE SMARTPHONES
===================================== */

@media(max-width:480px){

.footer-logo-image{

width:38px;

height:38px;

}

.brand-name{

font-size:1.35rem;

}

.brand-tagline{

font-size:.68rem;

}

.contact-icon{

width:42px;

height:42px;

font-size:1.05rem;

}

}

</style>
