<section id="contact">

  <div class="container">

    <div class="contact-wrapper">

      <!-- ===========================
           Linke Seite
      ============================ -->

      <div class="contact-info fade-up">

        <div class="contact-header">

          <span class="section-eyebrow">

            Kontakt

          </span>

          <h2>

            Ich freue mich auf
            <br>
            Ihre Anfrage.

          </h2>

          <p>

            Ob einmalige Unterstützung oder regelmäßige Hilfe –
            kontaktieren Sie mich ganz unverbindlich.

            Gemeinsam finden wir die passende
            Lösung für Ihren Alltag.

          </p>

        </div>

        <div class="contact-list">

          <div class="contact-item">

            <div class="contact-icon">

              ☎

            </div>

            <div>

              <strong>

                Telefon

              </strong>

              <p>

                <a href="tel:+436604623979">

                  0660 / 462 39 79

                </a>

              </p>

            </div>

          </div>

          <div class="contact-item">

            <div class="contact-icon">

              ✉

            </div>

            <div>

              <strong>

                E-Mail

              </strong>

              <p>

                <a href="mailto:alltagsservice@chello.at">

                  alltagsservice@chello.at

                </a>

              </p>

            </div>

          </div>

          <div class="contact-item">

            <div class="contact-icon">

              📍

            </div>

            <div>

              <strong>

                Einsatzgebiet

              </strong>

              <p>

                Osten Wiens & Umgebung

              </p>

            </div>

          </div>

          <div class="contact-item">

            <div class="contact-icon">

              🕒

            </div>

            <div>

              <strong>

                Erreichbarkeit

              </strong>

              <p>

                Montag bis Sonntag

                <br>

                08:00 – 18:00 Uhr

              </p>

            </div>

          </div>

        </div>

      </div>

      <!-- ===========================
           Formular
      ============================ -->

      <div class="contact-form fade-up">

        <form

          name="Kontakt"

          method="POST"

          action="/danke/"

          data-netlify="true"

          netlify-honeypot="bot-field">

          <input

            type="hidden"

            name="form-name"

            value="Kontakt">

          <p hidden>

            <label>

              Nicht ausfüllen:

              <input name="bot-field">

            </label>

          </p>

          <div class="form-row">

            <input

              type="text"

              name="name"

              placeholder="Ihr Name"

              required>

          </div>

          <div class="form-row">

            <input

              type="email"

              name="email"

              placeholder="Ihre E-Mail"

              required>

          </div>

          <div class="form-row">

            <input

              type="tel"

              name="telefon"

              placeholder="Telefon (optional)">

          </div>

          <div class="form-row textarea-row">

            <textarea

              name="nachricht"

              rows="7"

              placeholder="Wie kann ich Ihnen helfen?"

              required>

            </textarea>

          </div>

          <button

            class="btn"

            type="submit">

            Anfrage senden

          </button>

        </form>

      </div>

    </div>

  </div>

</section>
<style>

#contact{

background:linear-gradient(
180deg,
#F5F7F6 0%,
#FFFFFF 100%
);

}

/* ===================================
   GRID
=================================== */

.contact-wrapper{

display:grid;

grid-template-columns:1fr 1fr;

gap:70px;

align-items:stretch;

}

/* ===================================
   LINKE SPALTE
=================================== */

.contact-info{

display:flex;

flex-direction:column;

justify-content:space-between;

}

.contact-header{

margin-bottom:45px;

}

.contact-header h2{

margin:14px 0 24px;

max-width:520px;

}

.contact-header p{

max-width:520px;

line-height:1.9;

}

.contact-list{

display:flex;

flex-direction:column;

gap:22px;

margin-top:auto;

}

.contact-item{

display:flex;

align-items:flex-start;

gap:18px;

}

.contact-icon{

width:58px;

height:58px;

border-radius:18px;

background:#EAF5F3;

display:flex;

justify-content:center;

align-items:center;

font-size:1.45rem;

color:#8C4A00;

flex-shrink:0;

transition:.3s;

}

.contact-item:hover .contact-icon{

background:var(--petrol);

color:white;

transform:translateY(-2px);

}

.contact-item strong{

display:block;

margin-bottom:6px;

color:var(--petrol);

}

.contact-item p{

margin:0;

line-height:1.6;

}

.contact-item a{

color:var(--petrol);

font-weight:600;

text-decoration:none;

}

/* ===================================
   RECHTE SPALTE
=================================== */

.contact-form{

display:flex;

}

.contact-form form{

width:100%;

display:flex;

flex-direction:column;

background:white;

padding:42px;

border-radius:30px;

box-shadow:0 18px 45px rgba(0,0,0,.08);

}

.form-row{

margin-bottom:18px;

}

.textarea-row{

flex:1;

display:flex;

}

.textarea-row textarea{

flex:1;

min-height:180px;

resize:vertical;

}

.contact-form input,

.contact-form textarea{

width:100%;

padding:15px 18px;

border:1px solid #D7D7D7;

border-radius:14px;

font:inherit;

transition:.25s;

}

.contact-form input:focus,

.contact-form textarea:focus{

outline:none;

border-color:var(--petrol);

box-shadow:0 0 0 4px rgba(47,109,115,.10);

}

.contact-form .btn{

margin-top:auto;

width:100%;

padding:16px;

border:none;

border-radius:999px;

font-size:1rem;

font-weight:700;

cursor:pointer;

}

/* ===================================
   TABLET
=================================== */

@media(max-width:1024px){

.contact-wrapper{

grid-template-columns:1fr;

gap:55px;

}

.contact-info{

justify-content:flex-start;

}

.contact-header{

text-align:center;

}

.contact-header h2,

.contact-header p{

max-width:none;

}

.contact-list{

margin-top:40px;

}

}

/* ===================================
   SMARTPHONE
=================================== */

@media(max-width:768px){

#contact{

padding:80px 0;

}

.contact-form form{

padding:28px;

border-radius:22px;

}

.contact-item{

gap:14px;

}

.contact-icon{

width:52px;

height:52px;

font-size:1.2rem;

}

}

</style>
