---
---

<section id="contact">

  <div class="container">

    <div class="contact-wrapper">

      <div class="contact-info">

        <span class="section-eyebrow">

          Kontakt

        </span>

        <h2>

          Ich freue mich auf Ihre Anfrage.

        </h2>

        <p>

          Ob einmalige Unterstützung oder regelmäßige Hilfe –
          kontaktieren Sie mich ganz unverbindlich.
          Gemeinsam finden wir die passende Lösung für Ihren Alltag.

        </p>

        <div class="contact-list">

          <div class="contact-item">

            <div class="contact-icon">

              📞

            </div>

            <div>

              <strong>Telefon</strong>

              <p>

                <a href="tel:+436604623979">

                  0660 / 462 39 79

                </a>

              </p>

            </div>

          </div>

          <div class="contact-item">

            <div class="contact-icon">

              ✉️

            </div>

            <div>

              <strong>E-Mail</strong>

              <p>

                <a href="mailto:alltagsservice@chello.at">

                  alltagsservice@chello.at

                </a>

              </p>

            </div>

          </div>

          <div class="contact-item">

            <div class="contact-icon">

              📍

            </div>

            <div>

              <strong>Einsatzgebiet</strong>

              <p>

                Osten Wiens & Umgebung

              </p>

            </div>

          </div>

          <div class="contact-item">

            <div class="contact-icon">

              🕒

            </div>

            <div>

              <strong>Erreichbarkeit</strong>

              <p>

                Montag bis Sonntag<br>

                08:00 – 18:00 Uhr

              </p>

            </div>

          </div>

        </div>

      </div>

      <div class="contact-form">

        <form
          name="Kontakt"
          method="POST"
          data-netlify="true">

          <input
            type="hidden"
            name="form-name"
            value="Kontakt">

          <div class="form-row">

            <input
              type="text"
              name="name"
              placeholder="Ihr Name"
              required>

          </div>

          <div class="form-row">

            <input
              type="email"
              name="email"
              placeholder="Ihre E-Mail"
              required>

          </div>

          <div class="form-row">

            <input
              type="tel"
              name="telefon"
              placeholder="Telefon (optional)">

          </div>

          <div class="form-row">

            <textarea
              name="nachricht"
              rows="7"
              placeholder="Wie kann ich Ihnen helfen?"
              required></textarea>

          </div>
          <button
            class="btn"
            type="submit">

            Anfrage senden

          </button>

        </form>

      </div>

    </div>

  </div>

</section>

<style>

#contact{

background:linear-gradient(
180deg,
#F5F7F6 0%,
#FFFFFF 100%
);

}

.contact-wrapper{

display:grid;

grid-template-columns:1fr 1fr;

gap:60px;

align-items:start;

}

.contact-info{

padding-right:20px;

}

.contact-info h2{

margin-top:12px;

margin-bottom:28px;

}

.contact-info>p{

margin-bottom:40px;

}

.contact-list{

display:flex;

flex-direction:column;

gap:24px;

}

.contact-item{

display:flex;

align-items:flex-start;

gap:18px;

}

.contact-icon{

width:64px;

height:64px;

background:#EAF5F3;

border-radius:20px;

display:flex;

justify-content:center;

align-items:center;

font-size:1.7rem;

flex-shrink:0;

}

.contact-item strong{

display:block;

margin-bottom:6px;

color:var(--petrol);

}

.contact-item a{

color:var(--petrol);

font-weight:600;

transition:.25s;

}

.contact-item a:hover{

color:var(--orange);

}

.contact-form{

background:white;

padding:40px;

border-radius:28px;

box-shadow:var(--shadow);

}

.contact-form form{

display:flex;

flex-direction:column;

gap:18px;

}

.form-row{

width:100%;

}

.contact-form .btn{

width:100%;

margin-top:10px;

}

@media(max-width:1024px){

.contact-wrapper{

grid-template-columns:1fr;

gap:50px;

}

.contact-info{

padding-right:0;

}

}

@media(max-width:768px){

#contact{

padding-top:80px;

padding-bottom:80px;

}

.contact-wrapper{

gap:35px;

}

.contact-form{

padding:28px;

border-radius:22px;

}

.contact-icon{

width:56px;

height:56px;

font-size:1.5rem;

}

.contact-item{

gap:14px;

}

}

</style>
