---
---

<section id="contact">

  <div class="container">

    <div class="contact-wrapper">

      <div class="contact-info">

        <span class="section-eyebrow">

          Kontakt

        </span>

        <h2>

          Ich freue mich auf Ihre Nachricht.

        </h2>

        <p>

          Sie möchten Unterstützung im Alltag oder haben Fragen zu
          meinen Leistungen? Kontaktieren Sie mich ganz unverbindlich.
          Gemeinsam finden wir die passende Lösung.

        </p>

        <div class="contact-list">

          <div class="contact-item">

            <div class="contact-icon">

              📞

            </div>

            <div>

              <strong>Telefon</strong>

              <p>+43 XXX XXX XXXX</p>

            </div>

          </div>

          <div class="contact-item">

            <div class="contact-icon">

              ✉️

            </div>

            <div>

              <strong>E-Mail</strong>

              <p>info@alltagsservice.at</p>

            </div>

          </div>

          <div class="contact-item">

            <div class="contact-icon">

              📍

            </div>

            <div>

              <strong>Einsatzgebiet</strong>

              <p>Wien & Umgebung</p>

            </div>

          </div>

          <div class="contact-item">

            <div class="contact-icon">

              🕒

            </div>

            <div>

              <strong>Erreichbarkeit</strong>

              <p>Montag bis Freitag<br>08:00 – 18:00 Uhr</p>

            </div>

          </div>

        </div>

      </div>

      <div class="contact-form">

        <form>

          <div class="form-row">

            <input
              type="text"
              placeholder="Ihr Name"
              required>

          </div>

          <div class="form-row">

            <input
              type="email"
              placeholder="Ihre E-Mail"
              required>

          </div>

          <div class="form-row">

            <input
              type="tel"
              placeholder="Telefon (optional)">

          </div>

          <div class="form-row">

            <textarea
              placeholder="Wie kann ich Ihnen helfen?"
              rows="7"></textarea>

          </div>

          <button
            class="btn"
            type="submit">

            Nachricht senden

          </button>

        </form>

      </div>

    </div>

  </div>

</section>

<style>

#contact{

background:linear-gradient(
180deg,
#F5F7F6 0%,
#FFFFFF 100%
);

}

.contact-wrapper{

display:grid;

grid-template-columns:1fr 1fr;

gap:60px;

align-items:start;

}

.contact-info{

padding-right:20px;

}

.contact-info h2{

margin-top:12px;

margin-bottom:28px;

}

.contact-info>p{

margin-bottom:40px;

}

.contact-list{

display:flex;

flex-direction:column;

gap:24px;

}

.contact-item{

display:flex;

align-items:flex-start;

gap:18px;

}

.contact-icon{

width:64px;

height:64px;

background:#EAF5F3;

border-radius:20px;

display:flex;

justify-content:center;

align-items:center;

font-size:1.7rem;

flex-shrink:0;

}

.contact-item strong{

display:block;

margin-bottom:6px;

color:var(--petrol);

}

.contact-form{

background:white;

padding:40px;

border-radius:28px;

box-shadow:var(--shadow);

}
.contact-form form{

display:flex;

flex-direction:column;

gap:18px;

}

.form-row{

width:100%;

}

.contact-form input,
.contact-form textarea{

width:100%;

padding:16px 18px;

border:1px solid #d9d9d9;

border-radius:16px;

font-family:inherit;

font-size:1rem;

background:white;

transition:.30s;

}

.contact-form input:focus,
.contact-form textarea:focus{

outline:none;

border-color:var(--petrol);

box-shadow:0 0 0 3px rgba(47,109,115,.15);

}

.contact-form textarea{

resize:vertical;

min-height:180px;

}

.contact-form .btn{

margin-top:10px;

width:100%;

}

@media(max-width:1024px){

.contact-wrapper{

grid-template-columns:1fr;

gap:50px;

}

.contact-info{

padding-right:0;

}

}

@media(max-width:768px){

#contact{

padding-top:80px;

padding-bottom:80px;

}

.contact-wrapper{

gap:35px;

}

.contact-form{

padding:28px;

border-radius:22px;

}

.contact-icon{

width:56px;

height:56px;

font-size:1.5rem;

}

.contact-item{

gap:14px;

}

}

</style>
