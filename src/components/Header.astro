---
---

<header class="header">

  <div class="container header-inner">

    <a href="/" class="logo">

      <div class="logo-icon">

        🏡

      </div>

      <div class="logo-text">

        <span class="logo-title">

          Alltagsservice

        </span>

        <span class="logo-subtitle">

          Persönlich • Zuverlässig

        </span>

      </div>

    </a>

    <button
      class="menu-button"
      id="menuButton"
      aria-label="Menü öffnen"
      aria-expanded="false">

      <span></span>
      <span></span>
      <span></span>

    </button>

    <nav
      class="navigation"
      id="navigation">

      <a href="/">Start</a>

      <a href="#services">Leistungen</a>

      <a href="#why">Warum ich</a>

      <a href="#about">Über mich</a>

      <a href="#contact">Kontakt</a>

      <a
        href="#contact"
        class="header-button">

        Jetzt anfragen

      </a>

    </nav>

  </div>

</header>

<script>

const button=document.getElementById("menuButton");

const nav=document.getElementById("navigation");

button?.addEventListener("click",()=>{

nav?.classList.toggle("open");

button.classList.toggle("active");

const expanded=button.getAttribute("aria-expanded")==="true";

button.setAttribute("aria-expanded",(!expanded).toString());

});

document.querySelectorAll(".navigation a").forEach(link=>{

link.addEventListener("click",()=>{

nav?.classList.remove("open");

button?.classList.remove("active");

button?.setAttribute("aria-expanded","false");

});

});

</script>

<style>

.header{

position:sticky;

top:0;

z-index:1000;

background:rgba(255,255,255,.96);

backdrop-filter:blur(14px);

border-bottom:1px solid rgba(0,0,0,.05);

}

.header-inner{

height:88px;

display:flex;

justify-content:space-between;

align-items:center;

}

.logo{

display:flex;

align-items:center;

gap:14px;

}

.logo-icon{

width:54px;

height:54px;

border-radius:18px;

background:#EAF5F3;

display:flex;

justify-content:center;

align-items:center;

font-size:1.8rem;

}

.logo-title{

display:block;

font-size:1.35rem;

font-weight:800;

color:var(--petrol);

line-height:1;

}

.logo-subtitle{

display:block;

margin-top:4px;

font-size:.82rem;

color:#777;

}

.navigation{

display:flex;

align-items:center;

gap:34px;

}

.navigation a{

position:relative;

font-weight:600;

transition:.25s;

}

.navigation a:not(.header-button)::after{

content:"";

position:absolute;

left:0;

bottom:-8px;

width:0;

height:2px;

background:var(--orange);

transition:.3s;

}

.navigation a:hover{

color:var(--petrol);

}

.navigation a:hover::after{

width:100%;

}

.header-button{

display:inline-flex;

justify-content:center;

align-items:center;

padding:14px 24px;

border-radius:999px;

background:var(--orange);

color:white;

font-weight:700;

transition:.3s;

box-shadow:var(--shadow);

}

.header-button:hover{

transform:translateY(-3px);

box-shadow:var(--shadow-hover);

}

.menu-button{

display:none;

width:54px;

height:54px;

border:none;

background:none;

cursor:pointer;

position:relative;

}

.menu-button span{

display:block;

width:30px;

height:3px;

background:var(--petrol);

border-radius:10px;

margin:6px auto;

transition:.3s;

}
@media(max-width:980px){

.menu-button{

display:block;

z-index:1002;

}

.navigation{

position:absolute;

top:88px;

left:0;

right:0;

display:none;

flex-direction:column;

align-items:center;

gap:28px;

padding:35px 25px;

background:white;

box-shadow:0 20px 40px rgba(0,0,0,.12);

}

.navigation.open{

display:flex;

}

.navigation a{

font-size:1.05rem;

}

.header-button{

width:100%;

max-width:320px;

}

}

.menu-button.active span:nth-child(1){

transform:translateY(9px) rotate(45deg);

}

.menu-button.active span:nth-child(2){

opacity:0;

}

.menu-button.active span:nth-child(3){

transform:translateY(-9px) rotate(-45deg);

}

@media(max-width:640px){

.header-inner{

height:76px;

}

.logo-icon{

width:46px;

height:46px;

font-size:1.5rem;

}

.logo-title{

font-size:1.15rem;

}

.logo-subtitle{

font-size:.75rem;

}

.navigation{

top:76px;

padding:28px 20px;

gap:22px;

}

}

</style>
