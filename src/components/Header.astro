---

const navigation = [
  { href: "#services", label: "Leistungen" },
  { href: "#about", label: "Über mich" },
  { href: "#contact", label: "Kontakt" }
];

---

<header class="header">

  <div class="container header-inner">

    <a href="/" class="logo">

      <img
        src="/images/logo.png"
        alt="Logo Alltagsservice"
        class="logo-image"
      />

      <div class="logo-text">

        <span class="logo-title">
          Alltagsservice
        </span>

        <span class="logo-subtitle">
          Persönlich & zuverlässig
        </span>

      </div>

    </a>

    <nav>

      {
        navigation.map((item) => (

          <a href={item.href}>
            {item.label}
          </a>

        ))
      }

    </nav>

  </div>

</header>
<style>

.header{

position:sticky;

top:0;

z-index:1000;

background:rgba(255,255,255,.94);

backdrop-filter:blur(12px);

box-shadow:0 4px 20px rgba(0,0,0,.05);

}

.header-inner{

display:flex;

justify-content:space-between;

align-items:center;

padding:18px 0;

gap:30px;

}

.logo{

display:flex;

align-items:center;

gap:18px;

transition:.3s;

}

.logo:hover{

transform:translateY(-2px);

}

.logo-image{

width:64px;

height:64px;

border-radius:50%;

box-shadow:0 8px 20px rgba(0,0,0,.12);

transition:.3s;

flex-shrink:0;

}

.logo:hover .logo-image{

transform:scale(1.05);

}

.logo-text{

display:flex;

flex-direction:column;

}

.logo-title{

font-size:1.45rem;

font-weight:800;

color:var(--petrol);

line-height:1.1;

}

.logo-subtitle{

margin-top:4px;

font-size:.95rem;

color:var(--text-light);

font-weight:500;

}

nav{

display:flex;

align-items:center;

gap:36px;

}

nav a{

position:relative;

font-weight:600;

color:var(--text);

transition:.25s;

}

nav a:hover{

color:var(--petrol);

}

nav a::after{

content:"";

position:absolute;

left:0;

bottom:-6px;

width:0;

height:2px;

background:var(--orange);

transition:.3s;

}

nav a:hover::after{

width:100%;

}

@media(max-width:900px){

.header-inner{

flex-direction:column;

padding:16px 0;

}

.logo{

justify-content:center;

}

.logo-image{

width:56px;

height:56px;

}

.logo-title{

font-size:1.3rem;

text-align:center;

}

.logo-subtitle{

text-align:center;

font-size:.9rem;

}

nav{

gap:22px;

flex-wrap:wrap;

justify-content:center;

}

}

@media(max-width:600px){

.logo{

gap:14px;

}

.logo-image{

width:50px;

height:50px;

}

.logo-title{

font-size:1.15rem;

}

.logo-subtitle{

font-size:.82rem;

}

nav{

gap:16px;

font-size:.95rem;

}

}

</style>
