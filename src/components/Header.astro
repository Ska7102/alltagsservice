---

const navigation = [
  { href: "/", label: "Start" },
  { href: "/#services", label: "Leistungen" },
  { href: "/#about", label: "Über mich" },
  { href: "/#contact", label: "Kontakt" }
];

---

<header class="header">

  <div class="container header-inner">

    <a href="/" class="logo">

      <span class="logo-image-wrap">

        <img
          src="/images/logo.png"
          alt="Logo Alltagsservice"
          class="logo-image"
        />

      </span>

      <div class="logo-text">

        <span class="logo-title">
          Alltagsservice
        </span>

        <span class="logo-subtitle">
          Persönlich & zuverlässig
        </span>

      </div>

    </a>

    <nav>

      {
        navigation.map((item) => (

          <a href={item.href}>
            {item.label}
          </a>

        ))
      }

    </nav>

  </div>

</header>

<style>

.header{

position:sticky;

top:0;

z-index:1000;

background:rgba(255,255,255,.94);

backdrop-filter:blur(12px);

box-shadow:0 4px 20px rgba(0,0,0,.05);

}

.header-inner{

display:flex;

justify-content:space-between;

align-items:center;

padding:18px 0;

gap:30px;

}

.logo{

display:flex;

align-items:center;

gap:18px;

transition:.3s;

}

.logo:hover{

transform:translateY(-2px);

}


/* ==========================================
   Rundes Logo
========================================== */

.logo-image-wrap{

width:64px;

height:64px;

border-radius:50%;

overflow:hidden;

flex-shrink:0;

box-shadow:0 8px 20px rgba(0,0,0,.12);

transition:.3s;

}

.logo-image{

display:block;

width:100%;

height:100%;

object-fit:cover;

}

.logo:hover .logo-image-wrap{

transform:scale(1.05);

}


/* ==========================================
   Logo Text
========================================== */

.logo-text{

display:flex;

flex-direction:column;

}

.logo-title{

font-size:1.45rem;

font-weight:800;

color:var(--petrol);

line-height:1.1;

}

.logo-subtitle{

margin-top:4px;

font-size:.95rem;

color:var(--text-light);

font-weight:500;

}


/* ==========================================
   Navigation
========================================== */

nav{

display:flex;

align-items:center;

gap:36px;

}

nav a{

position:relative;

font-weight:600;

color:var(--text);

transition:.25s;

}

nav a:hover{

color:var(--petrol);

}

nav a::after{

content:"";

position:absolute;

left:0;

bottom:-6px;

width:0;

height:2px;

background:var(--orange);

transition:.3s;

}

nav a:hover::after{

width:100%;

}


/* ==========================================
   Smartphone Hochformat
========================================== */

@media(max-width:900px){

.header-inner{

flex-direction:column;

padding:11px 0;

gap:8px;

}

.logo{

justify-content:center;

gap:12px;

}

.logo-image-wrap{

width:48px;

height:48px;

}

.logo-title{

font-size:1.15rem;

text-align:center;

}

.logo-subtitle{

font-size:.78rem;

text-align:center;

margin-top:2px;

}

nav{

gap:17px;

flex-wrap:wrap;

justify-content:center;

font-size:.9rem;

}

}


/* ==========================================
   Kleine Smartphones
========================================== */

@media(max-width:600px){

.header-inner{

padding:9px 10px;

gap:6px;

}

.logo{

gap:10px;

}

.logo-image-wrap{

width:44px;

height:44px;

}

.logo-title{

font-size:1.05rem;

}

.logo-subtitle{

font-size:.72rem;

}

nav{

gap:13px;

font-size:.86rem;

}

}


/* ==========================================
   Smartphone Querformat
========================================== */

@media(max-width:900px) and (orientation:landscape){

.header-inner{

flex-direction:row;

padding:7px 0;

gap:15px;

}

.logo{

gap:9px;

flex-shrink:0;

}

.logo-image-wrap{

width:38px;

height:38px;

}

.logo-title{

font-size:1rem;

text-align:left;

}

.logo-subtitle{

font-size:.65rem;

margin-top:2px;

text-align:left;

}

nav{

gap:18px;

flex-wrap:nowrap;

font-size:.82rem;

white-space:nowrap;

}

nav a::after{

bottom:-3px;

}

}

</style>