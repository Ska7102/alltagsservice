---
import portrait from "../assets/images/portrait.png";
---

<section id="about">

  <div class="container">

    <div class="about-grid">

      <!-- Bild -->

      <div class="about-image fade-up">

        <div class="portrait-circle"></div>

        <img
          src={portrait.src}
          alt="Sascha Kattenberg"
          class="portrait"
          width="460"
          height="560"
          loading="lazy"
        />

      </div>

      <!-- Text -->

      <div class="about-content fade-up">

        <span class="section-eyebrow">

          Persönlich für Sie da

        </span>

        <h2>

          Ihr persönlicher Ansprechpartner

        </h2>

        <p class="lead">

          Lernen Sie die Person kennen,
          die Sie künftig im Alltag
          unterstützt.

        </p>

        <p>

          Mein Name ist
          <strong>Sascha Kattenberg.</strong>

          Ich unterstütze Menschen
          zuverlässig,
          freundlich
          und mit viel Engagement.

          Mir ist wichtig,
          dass Sie sich jederzeit
          gut aufgehoben fühlen.

        </p>

        <p>

          Ich bin überzeugt:

          Gute Unterstützung beginnt
          mit Vertrauen,
          gegenseitigem Respekt
          und einem offenen Ohr
          für Ihre Wünsche.

        </p>

        <div class="about-values">

          <div class="value">

            <div class="value-icon">

              🤝

            </div>

            <div>

              <strong>

                Persönliche Betreuung

              </strong>

              <p>

                Immer derselbe Ansprechpartner.

              </p>

            </div>

          </div>

          <div class="value">

            <div class="value-icon">

              ❤️

            </div>

            <div>

              <strong>

                Mit Herz dabei

              </strong>

              <p>

                Freundlich,
                respektvoll
                und zuverlässig.

              </p>

            </div>

          </div>

          <div class="value">

            <div class="value-icon">

              📍

            </div>

            <div>

              <strong>

                Regional für Sie da

              </strong>

              <p>

                Im Osten Wiens
                und Umgebung.

              </p>

            </div>

          </div>

        </div>

        <blockquote>

          „Ich unterstütze Sie so,
          wie ich selbst Unterstützung
          erwarten würde.“

        </blockquote>

        <div class="signature">

          <strong>

            Sascha Kattenberg

          </strong>

          <span>

            Inhaber · Alltagsservice Wien

          </span>

        </div>

      </div>

    </div>

  </div>

</section>
<style>

#about{

background:linear-gradient(
180deg,
#ffffff 0%,
#F8FAF9 100%
);

overflow:hidden;

}

.about-grid{

display:grid;

grid-template-columns:480px 1fr;

gap:90px;

align-items:center;

}

.about-image{

position:relative;

display:flex;

justify-content:center;

align-items:center;

min-height:620px;

}

.portrait-circle{

position:absolute;

width:420px;

height:420px;

border-radius:50%;

background:radial-gradient(

circle,

rgba(47,109,115,.10) 0%,

rgba(232,154,61,.12) 60%,

transparent 100%

);

z-index:1;

}

.portrait{

position:relative;

width:420px;

height:auto;

z-index:2;

filter:drop-shadow(0 25px 45px rgba(0,0,0,.16));

transition:.35s;

}

.portrait:hover{

transform:translateY(-8px) scale(1.02);

}

.about-content{

max-width:640px;

}

.about-content h2{

margin-bottom:18px;

}

.lead{

font-size:1.18rem;

margin-bottom:30px;

color:var(--petrol);

font-weight:500;

}

.about-content p{

margin-bottom:22px;

line-height:1.9;

}

.about-values{

display:grid;

gap:20px;

margin:42px 0;

}

.value{

display:flex;

align-items:flex-start;

gap:18px;

padding:18px 22px;

background:white;

border-radius:22px;

box-shadow:0 8px 24px rgba(0,0,0,.06);

transition:.3s;

}

.value:hover{

transform:translateY(-4px);

box-shadow:0 18px 35px rgba(0,0,0,.10);

}

.value-icon{

width:56px;

height:56px;

border-radius:18px;

background:#EAF5F3;

display:flex;

justify-content:center;

align-items:center;

font-size:1.6rem;

flex-shrink:0;

transition:.3s;

}

.value:hover .value-icon{

background:var(--petrol);

color:white;

}

.value strong{

display:block;

margin-bottom:6px;

color:var(--petrol);

font-size:1.05rem;

}

.value p{

margin:0;

font-size:.98rem;

line-height:1.6;

}

blockquote{

margin-top:45px;

padding:26px 28px;

background:#F5F7F6;

border-left:6px solid var(--orange);

border-radius:0 18px 18px 0;

font-size:1.15rem;

font-style:italic;

color:var(--petrol);

line-height:1.8;

}

.signature{

margin-top:30px;

padding-top:22px;

border-top:2px solid rgba(47,109,115,.08);

display:flex;

flex-direction:column;

gap:6px;

}

.signature strong{

font-size:1.3rem;

color:var(--petrol);

}

.signature span{

color:var(--text-light);

}
/* ==========================================
   Premium Animationen
========================================== */

.fade-up{

opacity:0;

transform:translateY(35px);

animation:fadeUp .8s ease forwards;

}

.fade-up:nth-child(2){

animation-delay:.15s;

}

@keyframes fadeUp{

from{

opacity:0;

transform:translateY(35px);

}

to{

opacity:1;

transform:translateY(0);

}

}

.portrait{

animation:floatPortrait 8s ease-in-out infinite;

}

@keyframes floatPortrait{

0%{

transform:translateY(0px);

}

50%{

transform:translateY(-10px);

}

100%{

transform:translateY(0px);

}

}

.portrait-circle{

animation:pulseCircle 10s ease-in-out infinite;

}

@keyframes pulseCircle{

0%{

transform:scale(1);

}

50%{

transform:scale(1.04);

}

100%{

transform:scale(1);

}

}

/* ==========================================
   Responsive
========================================== */

@media(max-width:1100px){

.about-grid{

grid-template-columns:1fr;

gap:60px;

text-align:center;

}

.about-content{

max-width:100%;

}

.about-image{

min-height:auto;

}

.about-values{

max-width:620px;

margin:40px auto;

}

.value{

text-align:left;

}

blockquote{

text-align:left;

}

.signature{

align-items:center;

}

}

@media(max-width:768px){

#about{

padding-top:80px;

padding-bottom:80px;

}

.portrait-circle{

width:300px;

height:300px;

}

.portrait{

width:250px;

}

.about-content h2{

font-size:2rem;

}

.lead{

font-size:1.05rem;

}

.about-values{

gap:16px;

}

.value{

padding:16px 18px;

}

.value-icon{

width:48px;

height:48px;

font-size:1.3rem;

}

blockquote{

font-size:1rem;

padding:20px;

}

}

@media(max-width:480px){

.portrait{

width:220px;

}

.about-content h2{

font-size:1.8rem;

}

.value{

gap:14px;

}

.value strong{

font-size:1rem;

}

.value p{

font-size:.92rem;

}

.signature strong{

font-size:1.15rem;

}

}

/* ==========================================
   Ende About V4
========================================== */

</style>
