---
import portrait from "../assets/images/portrait.png";
---

<section id="about">

  <div class="container">

    <div class="about-grid">

      <!-- ==========================
           LINKE SPALTE
      =========================== -->

      <div class="about-left fade-up">

        <div class="about-image">

          <div class="portrait-circle"></div>

          <img
            src={portrait.src}
            alt="Sascha Kattenberg"
            class="portrait"
            width="460"
            height="560"
            loading="lazy"
          />

        </div>

        <blockquote>

          „Ich unterstütze Sie so,
          wie ich selbst Unterstützung
          erwarten würde.“

        </blockquote>

        <div class="signature">

          <strong>

            Sascha Kattenberg

          </strong>

          <span>

            Inhaber · Alltagsservice Wien

          </span>

        </div>

      </div>

      <!-- ==========================
           RECHTE SPALTE
      =========================== -->

      <div class="about-content fade-up">

        <span class="section-eyebrow">

          Persönlich für Sie da

        </span>

        <h2>

          Ihr persönlicher Ansprechpartner

        </h2>

        <p class="lead">

          Lernen Sie die Person kennen,
          die Sie künftig im Alltag
          unterstützt.

        </p>

        <p>

          Mein Name ist 
          <strong> Sascha Kattenberg. </strong>

          Ich unterstütze Menschen
          zuverlässig,
          freundlich
          und mit viel Engagement.

          Gute Unterstützung beginnt
          für mich mit Vertrauen,
          gegenseitigem Respekt
          und einem offenen Ohr
          für Ihre Wünsche.

        </p>

        <div class="about-values">

          <div class="value">

            <div class="value-icon">

              🤝

            </div>

            <div>

              <strong>

                Persönliche Betreuung

              </strong>

              <p>

                Immer derselbe Ansprechpartner.

              </p>

            </div>

          </div>

          <div class="value">

            <div class="value-icon">

              ❤️

            </div>

            <div>

              <strong>

                Mit Herz dabei

              </strong>

              <p>

                Freundlich,
                respektvoll
                und zuverlässig.

              </p>

            </div>

          </div>

          <div class="value">

            <div class="value-icon">

              📍

            </div>

            <div>

              <strong>

                Regional für Sie da

              </strong>

              <p>

                Im Osten Wiens
                und Umgebung.

              </p>

            </div>

          </div>

        </div>

      </div>

    </div>

  </div>

</section>
<style>

#about{

background:linear-gradient(
180deg,
#ffffff 0%,
#F8FAF9 100%
);

overflow:hidden;

}

/* ==========================================
   GRID
========================================== */

.about-grid{

display:grid;

grid-template-columns:420px 1fr;

gap:90px;

align-items:start;

}

/* ==========================================
   LINKE SPALTE
========================================== */

.about-left{

display:flex;

flex-direction:column;

align-items:center;

}

.about-image{

position:relative;

display:flex;

justify-content:center;

align-items:flex-start;

margin-bottom:35px;

}

.portrait-circle{

position:absolute;

width:420px;

height:420px;

border-radius:50%;

background:radial-gradient(

circle,

rgba(47,109,115,.10) 0%,

rgba(232,154,61,.12) 60%,

transparent 100%

);

z-index:1;

animation:pulseCircle 10s ease-in-out infinite;

}

.portrait{

position:relative;

width:420px;

height:auto;

z-index:2;

filter:drop-shadow(0 24px 45px rgba(0,0,0,.16));

transition:.35s;

animation:floatPortrait 8s ease-in-out infinite;

}

.portrait:hover{

transform:translateY(-8px) scale(1.02);

}

/* ==========================================
   ZITAT
========================================== */

blockquote{

width:100%;

padding:24px 28px;

background:#F5F7F6;

border-left:6px solid var(--orange);

border-radius:0 18px 18px 0;

font-size:1.1rem;

font-style:italic;

color:var(--petrol);

line-height:1.8;

margin-bottom:26px;

}

.signature{

width:100%;

padding-top:20px;

border-top:2px solid rgba(47,109,115,.08);

display:flex;

flex-direction:column;

gap:6px;

}

.signature strong{

font-size:1.3rem;

color:var(--petrol);

}

.signature span{

color:var(--text-light);

}

/* ==========================================
   RECHTE SPALTE
========================================== */

.about-content{

max-width:650px;

}

.about-content h2{

margin:16px 0 20px;

}

.lead{

font-size:1.18rem;

font-weight:500;

color:var(--petrol);

margin-bottom:30px;

}

.about-content p{

line-height:1.9;

margin-bottom:24px;

}

/* ==========================================
   KARTEN
========================================== */

.about-values{

display:grid;

gap:18px;

margin-top:40px;

}

.value{

display:flex;

align-items:flex-start;

gap:18px;

padding:18px 22px;

background:white;

border-radius:22px;

box-shadow:0 8px 24px rgba(0,0,0,.06);

transition:.3s;

}

.value:hover{

transform:translateY(-4px);

box-shadow:0 18px 35px rgba(0,0,0,.10);

}

.value-icon{

width:56px;

height:56px;

border-radius:18px;

background:#EAF5F3;

display:flex;

justify-content:center;

align-items:center;

font-size:1.5rem;

flex-shrink:0;

transition:.3s;

}

.value:hover .value-icon{

background:var(--petrol);

color:white;

}

.value strong{

display:block;

margin-bottom:6px;

color:var(--petrol);

font-size:1.05rem;

}

.value p{

margin:0;

font-size:.97rem;

line-height:1.6;

}

/* ==========================================
   ANIMATIONEN
========================================== */

.fade-up{

opacity:0;

transform:translateY(35px);

animation:fadeUp .8s ease forwards;

}

.fade-up:nth-child(2){

animation-delay:.15s;

}

@keyframes fadeUp{

from{

opacity:0;

transform:translateY(35px);

}

to{

opacity:1;

transform:translateY(0);

}

}

@keyframes floatPortrait{

0%{transform:translateY(0);}

50%{transform:translateY(-10px);}

100%{transform:translateY(0);}

}

@keyframes pulseCircle{

0%{transform:scale(1);}

50%{transform:scale(1.04);}

100%{transform:scale(1);}

}

/* ==========================================
   TABLET
========================================== */

@media(max-width:1100px){

.about-grid{

grid-template-columns:1fr;

gap:60px;

}

.about-left{

order:1;

}

.about-content{

order:2;

max-width:100%;

text-align:center;

}

blockquote{

text-align:left;

}

.signature{

align-items:center;

}

.about-values{

max-width:620px;

margin:40px auto 0;

}

}

/* ==========================================
   SMARTPHONE
========================================== */

@media(max-width:768px){

#about{

padding:80px 0;

}

.portrait{

width:260px;

}

.portrait-circle{

width:300px;

height:300px;

}

.about-content h2{

font-size:2rem;

}

.lead{

font-size:1.05rem;

}

.value{

padding:16px 18px;

}

.value-icon{

width:48px;

height:48px;

font-size:1.25rem;

}

blockquote{

padding:20px;

font-size:1rem;

}

}

@media(max-width:480px){

.portrait{

width:220px;

}

.about-content h2{

font-size:1.8rem;

}

.signature strong{

font-size:1.15rem;

}

}

</style>
