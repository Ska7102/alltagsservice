---

const features = [
  {
    icon: "🤝",
    title: "Handschlag - Qualität",
    text: "Kein anonymer Dienst – Sie wissen, wer zu Ihnen kommt."
  },
  {
    icon: "🛠️",
    title: "Anpacken statt lange reden",
    text: "Mit Plan! Praktische Hilfe, unkompliziert und mit Hausverstand."
  },
  {
    icon: "📍",
    title: "Aus Ihrer Nachbarschaft",
    text: "1220 Donaustadt & 1210 Floridsdorf."
  }
];


const trustFeatures = [
  {
    icon: "⏱️",
    title: "Zuverlässig & pünktlich",
    text: "Vereinbarte Termine und Absprachen sind für mich selbstverständlich."
  },
  {
    icon: "❤️",
    title: "Mit Herz dabei",
    text: "Persönliche Unterstützung, respektvoller Umgang und ein offenes Ohr."
  },
  {
    icon: "🔄",
    title: "Flexible Unterstützung",
    text: "Einmalig oder regelmäßig – genau so, wie Sie meine Hilfe brauchen."
  }
];

---

<section id="about" class="about-section">

  <div class="container about-container">


    <!-- ==========================================
         EINLEITUNG
    =========================================== -->

    <div class="about-intro">

      <span class="section-eyebrow">
        Persönlich für Sie da
      </span>

      <h2 class="about-title">
        Ich weiß, dass im Alltag
        <br />
        manchmal einfach eine
        <span> helfende Hand fehlt.</span>
      </h2>

    </div>


    <!-- ==========================================
         HAUPTBEREICH
    =========================================== -->

    <div class="about-main">


      <!-- ========================================
           LINKER BEREICH – FOTO
      ========================================= -->

      <div class="about-person">

        <div class="portrait-card">

          <img
            src="/images/Foto.png"
            alt="Sascha Kattenberg – Inhaber von Alltagsservice Wien"
            class="portrait-image"
          />

        </div>


        <!-- Zitat -->

        <div class="about-quote">

          <div class="quote-mark">
            “
          </div>

          <p>
            Ich möchte Ihnen die Unterstützung
            bieten, die ich mir selbst wünschen
            würde: zuverlässig, respektvoll und
            ohne unnötige Umstände.
          </p>

        </div>


        <div class="person-name">
          Sascha Kattenberg
        </div>

        <div class="person-role">
          Inhaber · Alltagsservice Wien
        </div>

      </div>


      <!-- ========================================
           RECHTER BEREICH – TEXT
      ========================================= -->

      <div class="about-content">

<p>
  Mein Name ist <strong>Sascha Kattenberg</strong> und genau die
  möchte ich Ihnen reichen!
</p>

<p>
  Ich habe viele Jahre beruflich Verantwortung übernommen,
  Menschen begleitet, Teams organisiert und dafür gesorgt,
  dass auch dann eine gute Lösung gefunden wird, wenn es
  einmal schnell gehen muss.
</p>

<p>
  Dabei habe ich gelernt:
  <strong>Zuverlässigkeit, ein respektvoller Umgang und ein offenes Ohr</strong>
  sind oft genauso wichtig wie die eigentliche Hilfe.
</p>

<p>
  Heute möchte ich diese Erfahrung auf eine andere Art einsetzen –
  <strong>persönlich, unkompliziert und direkt vor Ort.</strong>
</p>

<p>
  Ob eine Arbeit im Garten, eine Möbelmontage, ein technisches
  Problem, eine Besorgung oder einfach jemand, der Sie zu einem
  Termin begleitet:
  <strong>Ich möchte Ihnen Dinge abnehmen, die im Alltag gerade
  schwierig, lästig oder einfach zu viel sind.</strong>
</p>

<p>
  Dabei geht es mir nicht darum, möglichst viele Aufgaben
  abzuarbeiten.
  <strong>Es geht darum, Ihnen wirklich eine Hilfe zu sein.</strong>
</p>

      </div>

    </div>


    <!-- ==========================================
         ERSTE KACHELREIHE
         Die bisherigen drei Kacheln
    =========================================== -->

    <div class="about-features">

      {
        features.map((feature) => (

          <article class="about-feature">

            <div class="feature-icon">
              {feature.icon}
            </div>

            <div class="feature-content">

              <h3>
                {feature.title}
              </h3>

              <p>
                {feature.text}
              </p>

            </div>

          </article>

        ))
      }

    </div>


    <!-- ==========================================
         ZWEITE KACHELREIHE
         Neue Vertrauensargumente
    =========================================== -->

    <div class="about-features about-features-trust">

      {
        trustFeatures.map((feature) => (

          <article class="about-feature">

            <div class="feature-icon">
              {feature.icon}
            </div>

            <div class="feature-content">

              <h3>
                {feature.title}
              </h3>

              <p>
                {feature.text}
              </p>

            </div>

          </article>

        ))
      }

    </div>


  </div>

</section>


<style>

/* ==========================================
   ABOUT – GRUNDLAYOUT
========================================== */

.about-section {

  background: #F5F7F6;

  position: relative;

  overflow: hidden;

}


.about-container {

  max-width: 1200px;

  margin: 0 auto;

}


/* ==========================================
   EINLEITUNG
========================================== */

.about-intro {

  max-width: 900px;

  margin: 0 auto 55px;

  text-align: center;

}


.about-intro .section-eyebrow {

  display: inline-block;

  margin-bottom: 22px;

}


.about-title {

  margin: 0;

  font-size: clamp(2rem, 4vw, 3.2rem);

  line-height: 1.18;

  color: var(--petrol);

  letter-spacing: -.5px;

}


.about-title span {

  color: var(--orange);

}


/* ==========================================
   HAUPTBEREICH
========================================== */

.about-main {

  display: grid;

  grid-template-columns: 320px minmax(0, 1fr);

  gap: 65px;

  align-items: start;

}


/* ==========================================
   PERSON / PORTRAIT
========================================== */

.about-person {

  width: 100%;

}


.portrait-card {

  width: 100%;

  border-radius: 24px;

  overflow: hidden;

  background: white;

  box-shadow: 0 12px 35px rgba(0, 0, 0, .08);

  display: flex;

  justify-content: center;

  align-items: center;

}


.portrait-image {

  display: block;

  width: auto;

  max-width: 100%;

  height: auto;

  object-fit: contain;

}


/* ==========================================
   ZITAT
========================================== */

.about-quote {

  position: relative;

  margin-top: 18px;

  padding: 20px 20px 20px 24px;

  background: white;

  border-left: 4px solid var(--orange);

  border-radius: 0 14px 14px 0;

  box-shadow: 0 8px 25px rgba(0, 0, 0, .05);

}


.quote-mark {

  position: absolute;

  left: 12px;

  top: 4px;

  font-size: 2.4rem;

  line-height: 1;

  color: var(--orange);

  opacity: .35;

}


.about-quote p {

  margin: 0;

  font-size: .9rem;

  line-height: 1.65;

  font-style: italic;

  color: #5F6869;

}


/* ==========================================
   NAME
========================================== */

.person-name {

  margin-top: 18px;

  font-weight: 800;

  color: var(--petrol);

  font-size: 1rem;

}


.person-role {

  margin-top: 4px;

  color: #7A8282;

  font-size: .82rem;

}


/* ==========================================
   TEXTBEREICH
========================================== */

.about-content {

  max-width: 720px;

}


.about-content p {

  margin: 0 0 20px;

  color: #5F6869;

  font-size: 1rem;

  line-height: 1.85;

}


.about-content p:last-child {

  margin-bottom: 0;

}


.about-content strong {

  color: var(--petrol);

  font-weight: 800;

}


/* ==========================================
   FEATURE-KACHELN
========================================== */

.about-features {

  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 20px;

  margin-top: 55px;

}


/* Zweite Reihe */

.about-features-trust {

  margin-top: 20px;

}


.about-feature {

  position: relative;

  display: flex;

  align-items: center;

  gap: 18px;

  min-height: 105px;

  padding: 20px 24px;

  background: white;

  border-radius: 18px;

  box-shadow: 0 10px 30px rgba(0, 0, 0, .06);

  border: 1px solid rgba(47, 109, 115, .06);

  overflow: hidden;

  transition:
    transform .35s ease,
    box-shadow .35s ease;

}


/* ==========================================
   LAUFENDER STREIFEN
========================================== */

.about-feature::before {

  content: "";

  position: absolute;

  left: 0;

  bottom: 0;

  width: 100%;

  height: 4px;

  background: linear-gradient(
    90deg,
    var(--petrol),
    var(--orange)
  );

  transform: scaleX(0);

  transform-origin: left;

  transition:
    transform .4s ease;

}


.about-feature:hover {

  transform: translateY(-7px);

  box-shadow: 0 18px 38px rgba(0, 0, 0, .11);

}


.about-feature:hover::before {

  transform: scaleX(1);

}


/* ==========================================
   FEATURE ICON
========================================== */

.feature-icon {

  width: 52px;

  height: 52px;

  flex: 0 0 52px;

  display: flex;

  align-items: center;

  justify-content: center;

  border-radius: 16px;

  background: #EAF5F3;

  font-size: 1.35rem;

  transition:
    transform .35s ease,
    background .35s ease;

}


.about-feature:hover .feature-icon {

  transform: scale(1.08) rotate(4deg);

  background: #E1F0EE;

}


/* ==========================================
   FEATURE TEXT
========================================== */

.feature-content {

  min-width: 0;

}


.feature-content h3 {

  margin: 0 0 5px;

  font-size: 1rem;

  color: var(--petrol);

}


.feature-content p {

  margin: 0;

  font-size: .82rem;

  line-height: 1.5;

  color: #737C7D;

}


/* ==========================================
   TABLET
========================================== */

@media (max-width: 1024px) {

  .about-main {

    grid-template-columns: 270px minmax(0, 1fr);

    gap: 45px;

  }


  .about-features {

    gap: 16px;

  }


  .about-feature {

    padding: 18px;

    gap: 14px;

  }


  .feature-icon {

    width: 46px;

    height: 46px;

    flex-basis: 46px;

    font-size: 1.2rem;

  }

}


/* ==========================================
   SMARTPHONE
========================================== */

@media (max-width: 768px) {

  .about-intro {

    margin-bottom: 40px;

  }


  .about-title {

    font-size: 2rem;

    line-height: 1.2;

  }


  .about-main {

    grid-template-columns: 1fr;

    gap: 35px;

  }


  .about-person {

    max-width: 340px;

    margin: 0 auto;

  }


  .about-content {

    max-width: none;

  }


  .about-content p {

    font-size: .95rem;

    line-height: 1.75;

  }


  .about-features {

    grid-template-columns: 1fr;

    gap: 14px;

    margin-top: 40px;

  }


  .about-features-trust {

    margin-top: 14px;

  }


  .about-feature {

    min-height: 0;

    padding: 18px 20px;

  }

}


/* ==========================================
   KLEINE SMARTPHONES
========================================== */

@media (max-width: 420px) {

  .about-title {

    font-size: 1.75rem;

  }


  .about-person {

    max-width: 300px;

  }


  .about-feature {

    padding: 17px;

  }

}


/* ==========================================
   REDUZIERTE BEWEGUNG
========================================== */

@media (prefers-reduced-motion: reduce) {

  .about-feature,
  .about-feature::before,
  .feature-icon {

    transition: none;

  }

}

</style>