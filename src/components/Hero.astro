<section id="hero" class="hero">

  <div class="container hero-grid">

    <!-- ==========================================
         TEXT
    ========================================== -->

    <div class="hero-content">

      <span class="hero-badge">
        1220 Donaustadt • 1210 Floridsdorf • Weitere Bezirke auf Anfrage
      </span>

      <h1>
        Persönliche Unterstützung
        <br>
        im Alltag in Wien.
      </h1>

      <p>
        Ihr Alltagsservice für
        <strong>{" "}1220 Donaustadt{" "}</strong>
        und
        <strong>{" "}1210 Floridsdorf.{" "}</strong>

        Ich erledige für Sie zuverlässig
        <strong>{" "}Gartenarbeiten</strong>,
        <strong>{" "}Möbelmontagen & Kleinreparaturen</strong>,
        <strong>{" "}Handy-, Computer- und Technikprobleme</strong>,
        <strong>{" "}Haushalt & Besorgungen{" "}</strong>
        und leiste gerne
        <strong>{" "}Gesellschaft & Unterstützung</strong>.

        Weitere Wiener Bezirke gerne nach Vereinbarung.
      </p>


      <div class="hero-buttons">

        <a
          href="#contact"
          class="btn">
          Jetzt Kontakt aufnehmen
        </a>

        <a
          href="#services"
          class="btn btn-outline">
          Leistungen ansehen
        </a>

      </div>


      <div class="hero-features">

        <div>
          <span>✔</span>
          Persönlicher Ansprechpartner
        </div>

        <div>
          <span>✔</span>
          Flexible Termine nach Vereinbarung
        </div>

        <div>
          <span>✔</span>
          Regional in 1220 & 1210 Wien
        </div>

      </div>

    </div>


    <!-- ==========================================
         LOGO
    ========================================== -->

    <div class="hero-logo">

      <div class="logo-circle"></div>

      <div class="hero-image-wrap">

        <img
          src="/images/logo-rund.png"
          alt="Alltagsservice Wien – Persönlich & zuverlässig"
          class="hero-image"
          width="500"
          height="500"
          loading="eager"
        />

      </div>

    </div>

  </div>

</section>


<style>

/* ==========================================
   HERO
========================================== */

.hero{

  background:linear-gradient(
    180deg,
    #FAF8F3 0%,
    #F5F7F6 100%
  );

  overflow:clip;

}


/* ==========================================
   DESKTOP GRID
========================================== */

.hero-grid{

  display:grid;

  grid-template-columns:1.1fr .9fr;

  align-items:center;

  gap:40px;

  min-height:100vh;

}


/* ==========================================
   TEXT
========================================== */

.hero-content{

  position:relative;

  z-index:2;

  animation:heroContentIn .8s ease-out both;

}


.hero-badge{

  display:inline-block;

  padding:10px 20px;

  border-radius:999px;

  background:#EAF5F3;

  color:var(--petrol);

  font-weight:700;

  margin-bottom:28px;

  font-size:.95rem;

}


.hero h1{

  margin-bottom:28px;

  max-width:650px;

}


.hero p{

  font-size:1.15rem;

  max-width:650px;

  margin-bottom:42px;

  line-height:1.9;

}


.hero p strong{

  color:var(--petrol);

  font-weight:700;

}


/* ==========================================
   BUTTONS
========================================== */

.hero-buttons{

  display:flex;

  gap:18px;

  flex-wrap:wrap;

  margin-bottom:45px;

}


/* ==========================================
   FEATURES
========================================== */

.hero-features{

  display:flex;

  flex-wrap:wrap;

  gap:22px;

  font-weight:600;

  color:var(--petrol);

}


.hero-features div{

  display:flex;

  align-items:center;

  gap:8px;

}


.hero-features span{

  color:var(--orange);

  font-size:1.2rem;

}


/* ==========================================
   LOGO-BEREICH
========================================== */

.hero-logo{

  position:sticky;

  top:110px;

  display:flex;

  justify-content:center;

  align-items:center;

  height:600px;

  align-self:start;

  overflow:visible;

  animation:logoSlideIn 1s ease-out both;

}


/* ==========================================
   HINTERGRUNDKREIS
========================================== */

.logo-circle{

  position:absolute;

  width:520px;

  height:520px;

  border-radius:50%;

  background:radial-gradient(
    circle,
    rgba(47,109,115,.12) 0%,
    rgba(47,109,115,.07) 55%,
    rgba(232,154,61,.04) 72%,
    transparent 100%
  );

  animation:floatCircle 8s ease-in-out infinite;

}


/* ==========================================
   LOGO WRAPPER
========================================== */

.hero-image-wrap{

  position:relative;

  z-index:2;

  width:500px;

  height:500px;

  display:flex;

  align-items:center;

  justify-content:center;

  margin-inline:auto;

  flex-shrink:0;

  overflow:visible;

}


/* ==========================================
   LOGO
========================================== */

.hero-image{

  display:block;

  width:500px !important;

  height:500px !important;

  max-width:none !important;

  max-height:none !important;

  object-fit:contain;

  flex-shrink:0;

  filter:drop-shadow(
    0 18px 35px rgba(0,0,0,.18)
  );

  animation:floatLogo 6s ease-in-out infinite;

  transition:filter .35s ease;

}


.hero-image:hover{

  filter:drop-shadow(
    0 22px 40px rgba(0,0,0,.22)
  );

}


/* ==========================================
   SLIDE-IN
========================================== */

@keyframes logoSlideIn{

  0%{

    opacity:0;

    transform:translateX(80px);

  }

  100%{

    opacity:1;

    transform:translateX(0);

  }

}


@keyframes heroContentIn{

  0%{

    opacity:0;

    transform:translateY(25px);

  }

  100%{

    opacity:1;

    transform:translateY(0);

  }

}


/* ==========================================
   SCHWEBE-EFFEKT
========================================== */

@keyframes floatLogo{

  0%{

    transform:translateY(0);

  }

  50%{

    transform:translateY(-10px);

  }

  100%{

    transform:translateY(0);

  }

}


@keyframes floatCircle{

  0%{

    transform:scale(1);

  }

  50%{

    transform:scale(1.04);

  }

  100%{

    transform:scale(1);

  }

}


/* ==========================================
   TABLET
========================================== */

@media(max-width:1024px){

  .hero-grid{

    grid-template-columns:1fr;

    text-align:center;

    gap:20px;

    padding-top:35px;

    padding-bottom:70px;

    min-height:auto;

  }


  .hero-content{

    order:2;

  }


  .hero-logo{

    order:1;

    position:relative;

    top:auto;

    height:520px;

    align-self:auto;

  }


  .hero h1,
  .hero p{

    max-width:none;

  }


  .hero-buttons{

    justify-content:center;

  }


  .hero-features{

    justify-content:center;

  }


  .logo-circle{

    width:470px;

    height:470px;

  }


  .hero-image-wrap{

    width:520px;

    height:520px;

  }


  .hero-image{

    width:520px !important;

    height:520px !important;

  }

}


/* ==========================================
   HANDY HOCHFORMAT
========================================== */

@media(max-width:768px){

  .hero{

    padding-top:20px;

    padding-bottom:60px;

    overflow:hidden;

  }


  .hero-grid{

    gap:5px;

    width:100%;

  }


  .hero-logo{

    width:100%;

    height:410px;

    display:flex;

    justify-content:center;

    align-items:center;

    overflow:hidden;

  }


  .logo-circle{

    width:370px;

    height:370px;

  }


  .hero-image-wrap{

    width:100%;

    height:430px;

    display:flex;

    justify-content:center;

    align-items:center;

    margin:0;

    overflow:visible;

  }


  .hero-image{

    width:min(430px, 90vw) !important;

    height:min(430px, 90vw) !important;

    max-width:90vw !important;

    max-height:90vw !important;

  }


  .hero-badge{

    font-size:.82rem;

    line-height:1.5;

    padding:8px 15px;

    margin-bottom:20px;

  }


  .hero h1{

    font-size:2.5rem;

    line-height:1.1;

  }


  .hero p{

    font-size:1rem;

    line-height:1.8;

  }


  .hero-buttons{

    flex-direction:column;

    align-items:center;

  }


  .hero-buttons .btn{

    width:100%;

    max-width:320px;

  }


  .hero-features{

    flex-direction:column;

    gap:14px;

    align-items:center;

  }

}


/* ==========================================
   KLEINE HANDYS
========================================== */

@media(max-width:480px){

  .hero-logo{

    height:360px;

  }


  .logo-circle{

    width:330px;

    height:330px;

  }


  .hero-image-wrap{

    width:100%;

    height:390px;

  }


  .hero-image{

    width:min(390px, 90vw) !important;

    height:min(390px, 90vw) !important;

    max-width:90vw !important;

    max-height:90vw !important;

  }


  .hero h1{

    font-size:2.25rem;

  }

}


/* ==========================================
   HANDY QUERFORMAT
========================================== */

@media(max-width:900px) and (orientation:landscape){

  .hero{

    padding-top:10px;

    padding-bottom:30px;

  }


  .hero-grid{

    grid-template-columns:1fr 1fr;

    gap:15px;

    min-height:calc(100vh - 70px);

    padding-top:10px;

    padding-bottom:20px;

  }


  .hero-content{

    order:1;

    text-align:left;

  }


  .hero-logo{

    order:2;

    position:sticky;

    top:75px;

    width:auto;

    height:330px;

  }


  .logo-circle{

    width:300px;

    height:300px;

  }


  .hero-image-wrap{

    width:340px;

    height:340px;

    margin-inline:auto;

  }


  .hero-image{

    width:340px !important;

    height:340px !important;

  }


  .hero-badge{

    font-size:.68rem;

    padding:5px 10px;

    margin-bottom:10px;

  }


  .hero h1{

    font-size:1.9rem;

    margin-bottom:12px;

  }


  .hero p{

    font-size:.82rem;

    line-height:1.5;

    margin-bottom:18px;

  }


  .hero-buttons{

    margin-bottom:18px;

    gap:8px;

  }


  .hero-features{

    gap:8px;

    font-size:.7rem;

  }

}

</style>