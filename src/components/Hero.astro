---
---

<section class="hero">

  <div class="container hero-grid">

    <div class="hero-content">

      <span class="hero-badge">
        Persönlich • Zuverlässig • Flexibel
      </span>

      <h1>

        Hilfe im Alltag –
        <span>damit Sie mehr Zeit für die wichtigen Dinge haben.</span>

      </h1>

      <p class="hero-text">

        Ich unterstütze Sie zuverlässig bei alltäglichen Aufgaben –
        vom Haushalt über Einkäufe bis hin zu Gartenarbeiten,
        Begleitungen und kleinen Reparaturen.
        Persönlich, freundlich und genau nach Ihren Bedürfnissen.

      </p>

      <div class="hero-buttons">

        <a
          href="#contact"
          class="btn">

          Jetzt anfragen

        </a>

        <a
          href="#services"
          class="btn btn-outline">

          Leistungen ansehen

        </a>

      </div>

      <div class="hero-facts">

        <div class="fact">

          <div class="fact-number">

            ✓

          </div>

          <div>

            <strong>Persönlicher Service</strong>

            <p>Ein Ansprechpartner für alle Anliegen.</p>

          </div>

        </div>

        <div class="fact">

          <div class="fact-number">

            ✓

          </div>

          <div>

            <strong>Flexible Termine</strong>

            <p>Einmalig oder regelmäßig buchbar.</p>

          </div>

        </div>

        <div class="fact">

          <div class="fact-number">

            ✓

          </div>

          <div>

            <strong>Wien & Umgebung</strong>

            <p>Schnell vor Ort, wenn Hilfe benötigt wird.</p>

          </div>

        </div>

      </div>

    </div>

    <div class="hero-image">

      <img
        src="/images/hero.jpg"
        alt="Alltagsservice Wien">

    </div>

  </div>

</section>

<style>

.hero{

background:linear-gradient(
180deg,
#FAF8F3 0%,
#F5F7F6 100%
);

overflow:hidden;

}

.hero-grid{

display:grid;

grid-template-columns:1.1fr .9fr;

align-items:center;

gap:70px;

min-height:720px;

}

.hero-content{

max-width:650px;

}

.hero-badge{

display:inline-flex;

align-items:center;

padding:10px 20px;

border-radius:999px;

background:#EAF5F3;

color:var(--petrol);

font-weight:700;

margin-bottom:28px;

}

.hero h1{

margin-bottom:30px;

letter-spacing:-1px;

}

.hero h1 span{

display:block;

margin-top:10px;

color:var(--petrol);

}

.hero-text{

font-size:1.15rem;

margin-bottom:45px;

max-width:560px;

}

.hero-buttons{

display:flex;

gap:18px;

flex-wrap:wrap;

margin-bottom:50px;

}

.hero-facts{

display:flex;

flex-direction:column;

gap:22px;

}

.fact{

display:flex;

align-items:flex-start;

gap:18px;

}

.fact-number{

width:42px;

height:42px;

border-radius:50%;

background:#EAF5F3;

display:flex;

justify-content:center;

align-items:center;

font-weight:700;

color:var(--petrol);

flex-shrink:0;

}

.fact strong{

display:block;

margin-bottom:4px;

color:var(--petrol);

}

.hero-image{

display:flex;

justify-content:center;

align-items:center;

position:relative;

}

.hero-image img{

width:100%;

max-width:540px;

height:640px;

object-fit:cover;

border-radius:30px;

box-shadow:0 30px 60px rgba(0,0,0,.15);

animation:floatImage 7s ease-in-out infinite;

}

@keyframes floatImage{

0%{

transform:translateY(0);

}

50%{

transform:translateY(-10px);

}

100%{

transform:translateY(0);

}

}
@media(max-width:980px){

.hero{

padding-top:60px;

}

.hero-grid{

grid-template-columns:1fr;

gap:50px;

min-height:auto;

}

.hero-content{

order:2;

text-align:center;

max-width:100%;

margin:auto;

}

.hero-text{

margin-left:auto;

margin-right:auto;

}

.hero-buttons{

justify-content:center;

}

.hero-buttons .btn{

width:100%;

max-width:340px;

}

.hero-facts{

margin-top:10px;

align-items:center;

}

.fact{

max-width:420px;

}

.hero-image{

order:1;

}

.hero-image img{

height:460px;

max-width:520px;

}

}

@media(max-width:640px){

.hero{

padding-top:40px;

}

.hero-grid{

gap:35px;

}

.hero h1{

font-size:2.6rem;

}

.hero-text{

font-size:1rem;

}

.hero-buttons{

flex-direction:column;

align-items:center;

}

.hero-buttons .btn{

max-width:100%;

}

.hero-image img{

height:340px;

border-radius:22px;

}

.fact{

text-align:left;

}

}

</style>
