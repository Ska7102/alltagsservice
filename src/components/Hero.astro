---

<section class="hero">

  <div class="container hero-grid">

    <div class="hero-content fade-up">

      <span class="hero-badge">

        Persönlich • Zuverlässig • Flexibel

      </span>

      <h1>

        Hilfe im Alltag –
        <br>
        persönlich & zuverlässig.

      </h1>

      <p>

        Ob Haushalt, Garten, Einkäufe oder Begleitung –
        ich unterstütze Sie zuverlässig, freundlich und genau dort,
        wo Sie Hilfe benötigen.

      </p>

      <div class="hero-buttons">

        <a
          href="#contact"
          class="btn">

          Jetzt Kontakt aufnehmen

        </a>

        <a
          href="#services"
          class="btn btn-outline">

          Leistungen ansehen

        </a>

      </div>

      <div class="hero-features">

        <div>

          <span>✔</span>

          Persönlicher Ansprechpartner

        </div>

        <div>

          <span>✔</span>

          Flexible Termine

        </div>

        <div>

          <span>✔</span>

          Unterstützung mit Herz

        </div>

      </div>

    </div>

    <div class="hero-logo fade-up">

      <div class="logo-circle"></div>

      <img
        src="/images/logo.png"
        alt="Alltagsservice Logo"
        class="hero-image"
        width="360"
        height="360"
        loading="eager" />

    </div>

  </div>

</section>
<style>

.hero{

background:linear-gradient(
180deg,
#FAF8F3 0%,
#F5F7F6 100%
);

overflow:hidden;

}

.hero-grid{

display:grid;

grid-template-columns:1.1fr .9fr;

align-items:center;

gap:80px;

min-height:78vh;

}

.hero-content{

position:relative;

z-index:2;

}

.hero-badge{

display:inline-block;

padding:10px 20px;

border-radius:999px;

background:#EAF5F3;

color:var(--petrol);

font-weight:700;

margin-bottom:28px;

}

.hero h1{

margin-bottom:28px;

max-width:620px;

}

.hero p{

font-size:1.15rem;

max-width:620px;

margin-bottom:40px;

}

.hero-buttons{

display:flex;

gap:18px;

flex-wrap:wrap;

margin-bottom:45px;

}

.hero-features{

display:flex;

flex-wrap:wrap;

gap:22px;

font-weight:600;

color:var(--petrol);

}

.hero-features div{

display:flex;

align-items:center;

gap:8px;

}

.hero-features span{

color:var(--orange);

font-size:1.2rem;

}

.hero-logo{

position:relative;

display:flex;

justify-content:center;

align-items:center;

min-height:500px;

}

.logo-circle{

position:absolute;

width:440px;

height:440px;

border-radius:50%;

background:radial-gradient(

circle,

rgba(232,154,61,.20) 0%,

rgba(47,109,115,.10) 60%,

transparent 100%

);

animation:floatCircle 8s ease-in-out infinite;

}

.hero-image{

position:relative;

width:360px;

height:auto;

z-index:2;

filter:drop-shadow(0 18px 35px rgba(0,0,0,.18));

animation:floatLogo 6s ease-in-out infinite;

transition:.35s;

}

.hero-image:hover{

transform:scale(1.05);

}

@keyframes floatLogo{

0%{

transform:translateY(0px);

}

50%{

transform:translateY(-10px);

}

100%{

transform:translateY(0px);

}

}

@keyframes floatCircle{

0%{

transform:scale(1);

}

50%{

transform:scale(1.05);

}

100%{

transform:scale(1);

}

}

@media(max-width:1024px){

.hero-grid{

grid-template-columns:1fr;

text-align:center;

gap:50px;

padding-top:40px;

}

.hero h1,
.hero p{

max-width:none;

}

.hero-buttons{

justify-content:center;

}

.hero-features{

justify-content:center;

}

.hero-logo{

min-height:auto;

}

.logo-circle{

width:340px;

height:340px;

}

.hero-image{

width:280px;

}

}

@media(max-width:768px){

.hero{

padding-top:60px;

padding-bottom:60px;

}

.hero h1{

font-size:2.6rem;

}

.hero p{

font-size:1rem;

}

.hero-buttons{

flex-direction:column;

align-items:center;

}

.hero-buttons .btn{

width:100%;

max-width:320px;

}

.hero-features{

flex-direction:column;

gap:14px;

}

.logo-circle{

width:260px;

height:260px;

}

.hero-image{

width:220px;

}

}

</style>
