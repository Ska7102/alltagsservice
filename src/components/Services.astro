---

const services = [

{
icon:"🧹",
title:"Haushalt",
text:"Unterstützung beim Putzen, Aufräumen, Wäsche, Fenster putzen sowie vielen weiteren alltäglichen Arbeiten."
},

{
icon:"🌿",
title:"Garten",
text:"Rasen mähen, Hecken schneiden, Laub entfernen, Unkraut jäten und allgemeine Gartenpflege."
},

{
icon:"🛒",
title:"Einkäufe",
text:"Einkäufe, Apothekengänge, Besorgungen oder kleine Erledigungen zuverlässig und pünktlich erledigt."
},

{
icon:"🚗",
title:"Fahrdienste",
text:"Begleitung zu Ärzten, Behörden, Terminen oder privaten Besorgungen im Raum Wien."
},

{
icon:"🔧",
title:"Kleine Reparaturen",
text:"Bilder aufhängen, Möbel montieren, Lampen wechseln und kleinere Arbeiten im Haushalt."
},

{
icon:"❤️",
title:"Persönliche Begleitung",
text:"Gesellschaft leisten, Spaziergänge oder Unterstützung bei wichtigen Terminen."
}

];

---

<section id="services">

<div class="container">

<div class="section-header">

<span class="section-eyebrow">

Leistungen

</span>

<h2 class="section-title">

Unterstützung,
<br>

genau dort,
wo Sie sie brauchen.

</h2>

<p class="section-subtitle">

Jeder Alltag ist anders.

Deshalb können Sie alle Leistungen
einzeln oder kombiniert buchen –
einmalig oder regelmäßig.

</p>

</div>

<div class="services-grid">

{

services.map((service)=>(

<article class="service-card">

<div class="service-icon">

{service.icon}

</div>

<h3>

{service.title}

</h3>

<p>

{service.text}

</p>

<a
href="#contact"
class="service-link">

Mehr erfahren →

</a>

</article>

))

}

</div>

</div>

</section>
<style>

#services{

background:white;

position:relative;

overflow:hidden;

}

.section-header{

text-align:center;

margin-bottom:70px;

}

.services-grid{

display:grid;

grid-template-columns:repeat(3,1fr);

gap:32px;

}

.service-card{

background:white;

border-radius:28px;

padding:38px;

display:flex;

flex-direction:column;

height:100%;

box-shadow:0 10px 35px rgba(0,0,0,.06);

border:1px solid rgba(47,109,115,.06);

transition:all .35s ease;

position:relative;

overflow:hidden;

}

.service-card::before{

content:"";

position:absolute;

left:0;

top:0;

width:100%;

height:5px;

background:linear-gradient(
90deg,
var(--petrol),
var(--orange)
);

transform:scaleX(0);

transform-origin:left;

transition:.35s;

}

.service-card:hover{

transform:translateY(-10px);

box-shadow:0 22px 45px rgba(0,0,0,.12);

}

.service-card:hover::before{

transform:scaleX(1);

}

.service-icon{

width:82px;

height:82px;

border-radius:24px;

background:#EAF5F3;

display:flex;

justify-content:center;

align-items:center;

font-size:2.3rem;

margin-bottom:28px;

transition:.35s;

}

.service-card:hover .service-icon{

transform:rotate(6deg) scale(1.08);

background:var(--petrol);

color:white;

}

.service-card h3{

margin-bottom:18px;

font-size:1.4rem;

}

.service-card p{

flex:1;

margin-bottom:32px;

line-height:1.85;

}

.service-link{

display:inline-flex;

align-items:center;

gap:8px;

font-weight:700;

color:var(--petrol);

transition:.3s;

}

.service-link:hover{

gap:14px;

color:var(--orange);

}

@media(max-width:1024px){

.services-grid{

grid-template-columns:repeat(2,1fr);

}

}

@media(max-width:768px){

#services{

padding-top:80px;

padding-bottom:80px;

}

.section-header{

margin-bottom:50px;

}

.services-grid{

grid-template-columns:1fr;

gap:24px;

}

.service-card{

padding:30px;

}

.service-icon{

width:70px;

height:70px;

font-size:2rem;

margin-bottom:22px;

}

.service-card h3{

font-size:1.3rem;

}

.service-card p{

margin-bottom:24px;

}

}

</style>
