---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Vielen Dank | Alltagsservice Wien">

<section class="thanks">

  <div class="container">

    <div class="thanks-card">

      <div class="thanks-icon">

        ✅

      </div>

      <h1>

        Vielen Dank!

      </h1>

      <p>

        Ihre Anfrage wurde erfolgreich übermittelt.

      </p>

      <p>

        Ich werde mich so rasch wie möglich
        persönlich bei Ihnen melden.

      </p>

      <a
        href="/"
        class="btn">

        Zur Startseite

      </a>

    </div>

  </div>

</section>

<style>

.thanks{

min-height:75vh;

display:flex;

align-items:center;

justify-content:center;

background:linear-gradient(
180deg,
#F5F7F6 0%,
#FFFFFF 100%
);

}

.thanks-card{

max-width:700px;

margin:auto;

padding:60px;

background:white;

border-radius:28px;

text-align:center;

box-shadow:0 15px 40px rgba(0,0,0,.08);

}

.thanks-icon{

font-size:4rem;

margin-bottom:25px;

}

.thanks p{

margin-top:18px;

}

.thanks .btn{

margin-top:35px;

display:inline-flex;

}

</style>

</Layout>