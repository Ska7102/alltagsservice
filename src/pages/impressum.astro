    margin: 0 auto;
    padding: 8rem 1.5rem 4rem;
  }

  .legal-page h1 {
    margin-bottom: 2rem;
    color: #1f4d36;
  }

  .legal-page p {
    line-height: 1.7;
    color: #555;
  }
</style>